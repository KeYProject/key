/*!
Abstract datatype of (typed) partial maps.

* Author: **Daniel Bruns**, **Daniel Drodt**
* Documentation added by **Alexander Weigl** <weigl@kit.edu>
*/

\sorts {
    \generic K;
    \generic V;
    Map<K, V>;
}

\functions {
    /*! Return a value from the given Map.  If value is undefined, `mapUndef` is used. */
    V mapGet<K, V>(Map<K, V>, K);

    /*! A unique value, which is returned by mapGet in case no mapping value is declared for the specified key. */
    \unique V mapUndef<V>;

    // constructors
    /*! Generalized quantifier for parametric maps. This is a generic constructor for parametric maps. */
    Map<K, V> mapForeach<K, V> {true, true}(boolean, V);

    /*! The empty map, which does not contain any entries. */
    Map<K, V> mapEmpty<K, V>;

    /*! A map, which contains only one entry. */
    Map<K, V> mapSingleton<K, V>(K, V);

    /*! Takes as arguments two maps and creates a new map from their entries. In case their domains overlap,
        entries of the second map are used for keys from the intersection. */
    Map<K, V> mapOverride<K, V>(Map<K, V>, Map<K, V>);

    /*! Converts a sequence to a map. The map domain consists of exactly those integers, which are inside the sequence bounds. */
    Map<int, V> pseq2map<V>(PSeq<V>);

    /*! Adds an entry to a map or overwrites an existing one. */
    Map<K, V> mapUpdate<K, V>(Map<K, V>, K, V);

    /*! Removes an entry from a map. */
    Map<K, V> mapRemove<K, V>(Map<K, V>, K);
}

\predicates {
    /*! Takes two arguments: key &#8712; K and map &#8712; Map<K, V>. Returns true iff key is in the domain of map. */
    inDomain<K, V>(Map<K, V>, K);
}
