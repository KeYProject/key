\rules(sequences:on) {

    // --------------------------------------------------------------------------
    // equality handling (derived rules)
    // --------------------------------------------------------------------------

    eqPSeqEmpty {
        \schemaVar \term PSeq<E> s;

        \find(s = pseqEmpty<E>)
        \replacewith(pseqLen<E>(s) = 0)
    };

    eqPSeqSingleton {
        \schemaVar \term PSeq<E> s;
        \schemaVar \term E x;

        \find(s = pseqSingleton<E>(x))
        \replacewith(pseqLen<E>(s) = 1 & pseqGet<E>(s, 0) = x)
    };

    eqPSeqSingleton2 {
        \schemaVar \term PSeq<E> s, s2;
        \schemaVar \term E x;

        \assumes(pseqSingleton<E>(x) = s2 ==>)
        \find(s = s2)
        \replacewith(pseqLen<E>(s) = 1 & pseqGet<E>(s, 0) = x)
    };

    eqPSeqConcat {
        \schemaVar \term PSeq<E> s, s1, s2;

        \find(s = pseqConcat<E>(s1, s2))

        \replacewith(
            pseqLen<E>(s) = pseqLen<E>(s1) + pseqLen<E>(s2)
            & pseqSub<E>(s, 0, pseqLen<E>(s1)) = s1
            & pseqSub<E>(s, pseqLen<E>(s1), pseqLen<E>(s)) = s2
        )
        \generate(\EQ(pseqConcat<E>(s1, s2)))
    };

    eqPSeqConcat2 {
        \schemaVar \term PSeq<E> s, s1, s2;

        \find(pseqConcat<E>(s, s1) = pseqConcat<E>(s, s2))

        \replacewith(s1 = s2)
        \heuristics(seqSimplify)
        \generate(\EQ(pseqConcat<E>(s, s2) : no_self_application, seqSimplify))
    };

    eqPSeqConcat3 {
        \schemaVar \term PSeq<E> s, s1, s2;

        \find(pseqConcat<E>(s1, s) = pseqConcat<E>(s2, s))

        \replacewith(s1 = s2)
        \heuristics(seqSimplify)
        \generate(\EQ(pseqConcat<E>(s2, s) : no_self_application, seqSimplify))
    };

    eqPSeqConcat4 {
        \schemaVar \term PSeq<E> s1, s2;
        \schemaVar \term E x, y;

        \find(pseqConcat<E>(s1, pseqSingleton<E>(x)) = pseqConcat<E>(s2, pseqSingleton<E>(y)))

        \replacewith(s1 = s2 & x = y)
        \heuristics(seqSimplify)
    };

    eqPSeqConcat4EQ {
        \schemaVar \term PSeq<E> s1, s2, EQ;
        \schemaVar \term E x, y;

        \assumes(pseqConcat<E>(s2, pseqSingleton<E>(x)) = EQ ==>)
        \find(pseqConcat<E>(s1, pseqSingleton<E>(y)) = EQ)

        \replacewith(s1 = s2 & x = y)
        \heuristics(no_self_application, seqSimplify)
    };

    eqPSeqConcat5 {
        \schemaVar \term PSeq<E> s1, s2;
        \schemaVar \term E x, y;

        \find(pseqConcat<E>(pseqSingleton<E>(x), s1) = pseqConcat<E>(pseqSingleton<E>(y), s2))

        \replacewith(x = y & s1 = s2)
        \heuristics(seqSimplify)
    };

    eqPSeqConcat5EQ {
        \schemaVar \term PSeq<E> s1, s2, EQ;
        \schemaVar \term E x, y;

        \assumes(pseqConcat<E>(pseqSingleton<E>(x), s2) = EQ ==>)
        \find(pseqConcat<E>(pseqSingleton<E>(y), s1) = EQ)

        \replacewith(x = y & s1 = s2)
        \heuristics(no_self_application, seqSimplify)
    };

    eqPSeqReverse {
        \schemaVar \term PSeq<E> s, s2;
        \schemaVar \variables int iv;

        \find(s = pseqReverse<E>(s2))
        \varcond(\notFreeIn(iv, s), \notFreeIn(iv, s2))

        \replacewith(
            pseqLen<E>(s) = pseqLen<E>(pseqReverse<E>(s2))
            & \forall iv; (0 <= iv & iv < pseqLen<E>(s)
                -> pseqGet<E>(s, iv) = pseqGet<E>(pseqReverse<E>(s2), iv)
            )
        )
    };

    eqPSeqReverse2 {
        \schemaVar \term PSeq<E> s, s2, t;
        \schemaVar \variables int iv;

        \assumes(pseqReverse<E>(s2) = t ==>)
        \find(s = t)
        \varcond(\notFreeIn(iv, s), \notFreeIn(iv, s2), \notFreeIn(iv, t))

        \replacewith(
            pseqLen<E>(s) = pseqLen<E>(pseqReverse<E>(s2))
            & \forall iv; (0 <= iv & iv < pseqLen<E>(s)
                -> pseqGet<E>(s, iv) = pseqGet<E>(pseqReverse<E>(s2), iv)
            )
        )
    };

    eqPSeqDef {
        \schemaVar \term PSeq<E> s;
        \schemaVar \term int l, u;
        \schemaVar \term E a;
        \schemaVar \variables int i, iv;

        \find(s = pseqDef<E>{i;}(l, u, a))
        \varcond(
            \notFreeIn(iv, s),
            \notFreeIn(iv, l),
            \notFreeIn(iv, u),
            \notFreeIn(iv, a))

        \replacewith(
            pseqLen<E>(s) = pseqLen<E>(pseqDef<E>{i;}(l, u, a))
            & \forall iv; (0 <= iv & iv < pseqLen<E>(s)
                -> pseqGet<E>(s, iv) = pseqGet<E>(pseqDef<E>{i;}(l, u, a), iv)
            )
        )
    };

    eqPSeqDef2 {
        \schemaVar \term PSeq<E> s, t;
        \schemaVar \term int l, u;
        \schemaVar \term E a;
        \schemaVar \variables int i, iv;

        \assumes(pseqDef<E>{i;}(l, u, a) = t ==>)
        \find(s = t)
        \varcond(
            \notFreeIn(iv, s),
            \notFreeIn(iv, l),
            \notFreeIn(iv, u),
            \notFreeIn(iv, a),
            \notFreeIn(iv, t))

        \replacewith(
            pseqLen<E>(s) = pseqLen<E>(pseqDef<E>{i;}(l, u, a))
            & \forall iv; (0 <= iv & iv < pseqLen<E>(s)
                -> pseqGet<E>(s, iv) = pseqGet<E>(pseqDef<E>{i;}(l, u, a), iv)
            )
        )
    };

    \lemma
    eqSamePSeq {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term int from, to;
        \schemaVar \variables int iv;

        \find(pseqSub<E>(seq, from, to) = seq)
        \varcond(\notFreeIn(iv, from, seq))

        \replacewith((from = 0 & pseqLen<E>(seq) = to)
            | (to <= from & pseqLen<E>(seq) = 0)
            | (pseqLen<E>(seq) = to - from
                & \forall iv; (
                    0 <= iv & iv < pseqLen<E>(seq)
                    -> pseqGet<E>(seq, iv) = pseqGet<E>(seq, iv + from)))
        )
    };
}
