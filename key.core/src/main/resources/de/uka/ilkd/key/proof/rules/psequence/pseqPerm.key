// This file contains the rule set for permutations in
// the sequence data type
// author P.H. Schmitt


// This file contains RULES for the permutation predicates in
// the sequence datatype.

// Find the DECLARATIONS in file seq.key and
// definitional extensions in file seqRules.key

\rules(sequences:on, moreSeqRules:on) {
    // --------------------------------------------------------------------------
    //  Second Extensions by Definitions
    //  These taclets were not part of the original PSeq<E> axiomatization by
    //  B.Weiss
    //  These taclets extend the signature of the core theory by introducing
    //  the relation symbols
    //            pseqPerm(Seq,Seq), pseqNPerm(Seq)
    //  and the function symbols
    //           PSeq<E> seqSwap(Seq,int,int)
    //           PSeq<E> seqRemove(Seq,int)
    //  by direct definitions.
    //  Consistency of the extended theory is thus guaranteed.
    //  (Theorem on  conservative extensions)
    // --------------------------------------------------------------------------

    pseqNPermDefReplace {
        \schemaVar \term PSeq<int> s1;
        \schemaVar \variables int iv, jv;

        \find(pseqNPerm(s1))
        \varcond(\notFreeIn(iv, s1), \notFreeIn(jv, s1))

        \replacewith(
            (\forall iv; (0 <= iv & iv < pseqLen<int>(s1) ->
                    \exists jv; (0 <= jv & jv < pseqLen<int>(s1) & pseqGet<int>(s1, jv) = iv))))
    };

    pseqNPermDefLeft {
        \schemaVar \term PSeq<int> s1;
        \schemaVar \variables int iv, jv;

        \find(pseqNPerm(s1) ==>)
        \varcond(\notFreeIn(iv, s1), \notFreeIn(jv, s1))

        \add(
            (\forall iv; (0 <= iv & iv < pseqLen<int>(s1) ->
                    \exists jv; (0 <= jv & jv < pseqLen<int>(s1) & pseqGet<int>(s1, jv) = iv))) ==>)
    };

    pseqPermDefLeft {
        \schemaVar \term PSeq<E> s1, s2;
        \schemaVar \variables int iv;
        \schemaVar \variables PSeq<int> s;

        \find(pseqPerm<E>(s1, s2) ==>)

        \varcond(\notFreeIn(iv, s1, s2),
            \notFreeIn(s, s1, s2))

        \add(
            pseqLen<E>(s1) = pseqLen<E>(s2) &
            (\exists s; (pseqLen<int>(s) = pseqLen<E>(s1) & pseqNPerm(s) &

                    (\forall iv; (0 <= iv & iv < pseqLen<int>(s) ->
                            pseqGet<E>(s1, iv) = pseqGet<E>(s2, pseqGet<int>(s, iv))))))
            ==>)
    };

    pseqPermDef {
        \schemaVar \term PSeq<E> s1, s2;
        \schemaVar \variables int iv;
        \schemaVar \variables PSeq<int> s;

        \find(pseqPerm<E>(s1, s2))

        \varcond(\notFreeIn(iv, s1, s2),
            \notFreeIn(s, s1, s2))

        \replacewith(
            pseqLen<E>(s1) = pseqLen<E>(s2) &
            (\exists s; (pseqLen<int>(s) = pseqLen<E>(s1) & pseqNPerm(s) &

                    (\forall iv; (0 <= iv & iv < pseqLen<int>(s) ->
                            pseqGet<E>(s1, iv) = pseqGet<E>(s2, pseqGet<int>(s, iv))))))
        )
    };

    defOfPSeqSwap {
        \schemaVar \term PSeq<E> s;
        \schemaVar \term int iv, jv;
        \schemaVar \variables int uSub;

        \find(pseqSwap<E>(s, iv, jv))

        \varcond(\notFreeIn(uSub, s),
            \notFreeIn(uSub, iv),
            \notFreeIn(uSub, jv))
        \replacewith(pseqDef<E>{uSub;}(0, pseqLen<E>(s),
                \if(!(0 <= iv & 0 <= jv & iv < pseqLen<E>(s) & jv < pseqLen<E>(s)))
                    \then(pseqGet<E>(s, uSub))
                    \else(\if(uSub = iv)
                            \then(pseqGet<E>(s, jv))
                            \else(\if(uSub = jv)
                                    \then(pseqGet<E>(s, iv))
                                    \else(pseqGet<E>(s, uSub))))))

    };

    defOfPSeqRemove {
        \schemaVar \term PSeq<E> s;
        \schemaVar \term int iv;
        \schemaVar \variables int uSub;

        \find(pseqRemove<E>(s, iv))
        \varcond(\notFreeIn(uSub, s),
            \notFreeIn(uSub, iv))

        \replacewith(
            \if(iv < 0 | pseqLen<E>(s) <= iv)
                \then(s)
                \else(pseqDef<E>{uSub;}(0, pseqLen<E>(s) - 1,
                        \if(uSub < iv)
                            \then(pseqGet<E>(s, uSub))
                            \else(pseqGet<E>(s, uSub + 1)))))
    };

    // --------------------------------------------------------------------
    // definition for seqNPermInv
    //
    // --------------------------------------------------------------------

    defOfSPeqNPermInv {
        \schemaVar \term PSeq<int> s;
        \schemaVar \variables int uSub;

        \find(pseqNPermInv(s))
        \varcond(\notFreeIn(uSub, s))

        \replacewith(pseqDef<int>{uSub;}(0, pseqLen<int>(s), pseqIndexOf<int>(s, uSub)))
    };

    // ==================================================================
    //  derived taclets involving the functions seqSwap, seqRemove,
    //  and seqNPermInv
    //
    // ==================================================================

    pseqLenOfNPermInv {
        \schemaVar \term PSeq<int> s1;
        \find(pseqLen<int>(pseqNPermInv(s1)))
        \replacewith(pseqLen<int>(s1))

        \heuristics(simplify)
    };

    /*\lemma
    pseqGetAnyOfNPermInv {
        \schemaVar \term PSeq<int> s1;
        \schemaVar \term int i3;

        \find(pseqGet<int>(seqNPermInv(s1), i3))
        \replacewith(pseqGet<int>(seqNPermInv(s1), i3));
        \add( ==> 0 <= i3 & i3 < pseqLen<E>(s1))
        \heuristics(simplify)
    };*/

    pseqGetOfNPermInv {
        \schemaVar \term PSeq<int> s1;
        \schemaVar \term int i3;
        \schemaVar \skolemTerm int jsk;

        \find(pseqGet<int>(pseqNPermInv(s1), i3))
        \varcond(\newDependingOn(jsk, i3))
        \replacewith(jsk)
        \add(pseqGet<int>(s1, jsk) = i3 & 0 <= jsk & jsk < pseqLen<int>(s1) ==>);
        \add( ==> 0 <= i3 & i3 < pseqLen<int>(s1) & pseqNPerm(s1))

        \heuristics(simplify)
    };

    pseqLenOfSwap {
        \schemaVar \term PSeq<E> s1;
        \schemaVar \term int iv1, iv2;
        \find(pseqLen<E>(pseqSwap<E>(s1, iv1, iv2)))
        \replacewith(pseqLen<E>(s1))

        \heuristics(simplify)
    };

    pseqGetOfSwap {
        \schemaVar \term Object o;
        \schemaVar \term PSeq<E> s1;
        \schemaVar \term int iv, jv, idx;
        \schemaVar \term Heap h;

        //  Differs from seqOutsideValue in seqStandard-new-verify.key
        //

        \find(pseqGet<E>(pseqSwap<E>(s1, iv, jv), idx))
        \replacewith(\if(!(0 <= iv & 0 <= jv & iv < pseqLen<E>(s1) & jv < pseqLen<E>(s1)))
                \then(pseqGet<E>(s1, idx))
                \else(\if(idx = iv)
                        \then(pseqGet<E>(s1, jv))
                        \else(\if(idx = jv)
                                \then(pseqGet<E>(s1, iv))
                                \else(pseqGet<E>(s1, idx)))))

        \heuristics(simplify_enlarging)
    };

    pseqLenOfRemove {
        \schemaVar \term PSeq<E> s1;
        \schemaVar \term int iv1;

        \find(pseqLen<E>(pseqRemove<E>(s1, iv1)))
        \replacewith(
            \if(0 <= iv1 & iv1 < pseqLen<E>(s1))
                \then(pseqLen<E>(s1) - 1)
                \else(pseqLen<E>(s1)))

        \heuristics(simplify_enlarging)
    };

    //  Differs from seqOutsideValue in seqStandard-new-verify.key
    //

    pseqGetOfRemoveAny {
        \schemaVar \term PSeq<E> s1;
        \schemaVar \term int i3, i2;

        \find(pseqGet<E>(pseqRemove<E>(s1, i2), i3))
        \replacewith(\if(i2 < 0 | pseqLen<E>(s1) <= i2)
                \then(pseqGet<E>(s1, i3))
                \else(\if(i3 < i2)
                        \then(pseqGet<E>(s1, i3))
                        \else(\if(i2 <= i3 & i3 < pseqLen<E>(s1) - 1)
                                \then(pseqGet<E>(s1, i3 + 1))
                                \else(pseqGetOutside<E>))))

        \heuristics(simplify_enlarging)
    };

    pseqGetOfRemoveInt {
        \schemaVar \term PSeq<int> s1;
        \schemaVar \term int i3, i2;

        \find(pseqGet<int>(pseqRemove<int>(s1, i2), i3))
        \replacewith(\if(i2 < 0 | pseqLen<int>(s1) <= i2)
                \then(pseqGet<int>(s1, i3))
                \else(\if(i3 < i2)
                        \then(pseqGet<int>(s1, i3))
                        \else(\if(i2 <= i3 & i3 < pseqLen<int>(s1) - 1)
                                \then(pseqGet<int>(s1, i3 + 1))
                                \else(pseqGetOutside<int>))))

        \heuristics(simplify_enlarging)
    };

    pseqLenOfRemoveConcrete1 {
        \schemaVar \term PSeq<E> s1;

        \assumes(pseqLen<E>(s1) >= 1 ==>)
        \find(pseqLen<E>(pseqRemove<E>(s1, pseqLen<E>(s1) - 1)))
        \replacewith(pseqLen<E>(s1) - 1)

        \heuristics(simplify)
    };

    pseqLenOfRemoveConcrete2 {
        \schemaVar \term PSeq<E> s1;

        \assumes(pseqLen<E>(s1) >= 1 ==>)
        \find(pseqLen<E>(pseqRemove<E>(s1, 0)))
        \replacewith(pseqLen<E>(s1) - 1)

        \heuristics(simplify)
    };

    //  Differs from seqOutsideValue in seqStandard-new-verify.key
    //

    pseqGetOfRemoveAnyConcrete1 {
        \schemaVar \term PSeq<E> s1;
        \schemaVar \term int i3, i2;
        \assumes(pseqLen<E>(s1) >= 1 ==>)
        \find(pseqGet<E>(pseqRemove<E>(s1, pseqLen<E>(s1) - 1), i3))
        \replacewith(\if(i3 < pseqLen<E>(s1) - 1)
                \then(pseqGet<E>(s1, i3))
                \else(pseqGetOutside<E>))

        \heuristics(simplify_enlarging)
    };

    //  Differs from seqOutsideValue in seqStandard-new-verify.key
    //

    pseqGetOfRemoveAnyConcrete2 {
        \schemaVar \term PSeq<E> s1;
        \schemaVar \term int i3, i2;
        \assumes(pseqLen<E>(s1) >= 1 ==>)
        \find(pseqGet<E>(pseqRemove<E>(s1, 0), i3))
        \replacewith(\if(0 <= i3 & i3 < pseqLen<E>(s1) - 1)
                \then(pseqGet<E>(s1, i3 + 1))
                \else(pseqGetOutside<E>))

        \heuristics(simplify_enlarging)
    };

    // --------------------------------------------------------------------------
    //  derived basic properties of permutations on natural
    //  numbers
    //
    // --------------------------------------------------------------------------


    //
    //  The following taclet formalizes a kind of pidgeon hole principle
    //  It is the only taclet whose derivation requires induction
    //

    // pseqNPermRange {
    //        \schemaVar \term PSeq<int> s;
    //        \schemaVar \variables int iv;
    //      \find(pseqNPerm(s) ==> )
    //      \varcond( \notFreeIn (iv,s)  )
    //      \add(\forall iv;((0 <= iv & iv <  pseqLen<int>(s))
    //         ->  (0 <= pseqGet<int>(s,iv) &  pseqGet<int>(s,iv) < ppseqLen<int>(s))) ==>)
    //            };
    // Improved version by PHS, correctness proof from Oct.19.2016

    \lemma
    pseqNPermRange {
        \schemaVar \term PSeq<int> s;
        \schemaVar \variables int iv;
        \find(pseqNPerm(s) ==>)
        \varcond(\notFreeIn(iv, s))
        \add(\forall iv; ((0 <= iv & iv < pseqLen<int>(s))
                -> (0 <= pseqGet<int>(s, iv) & pseqGet<int>(s, iv) < pseqLen<int>(s) &
                    instance<int>(pseqGet<int>(s, iv)) = TRUE)) ==>)

    };

    //
    //  The following taclet formalizes the mathematical fact
    //  that every sujective function from a finite set into
    //  itself is injective.
    //  It can be proved using the previous taclet without induction.
    //

    pseqNPermInjective {
        \schemaVar \term PSeq<int> s;
        \schemaVar \variables int iv, jv;
        \find(pseqNPerm(s) ==>)
        \varcond(\notFreeIn(iv, s), \notFreeIn(jv, s))
        \add(\forall iv; (\forall jv; (
                    (0 <= iv & iv < pseqLen<int>(s) & 0 <= jv & jv < pseqLen<int>(s)
                        & pseqGet<int>(s, iv) = pseqGet<int>(s, jv))
                    -> iv = jv)) ==>)

    };

    // More transitivity rules (used for automation, see at end)

    \lemma
    pseqPermTrans {
        \schemaVar \term PSeq<E> s1, s2, s3;

        \assumes(pseqPerm<E>(s2, s3) ==>)
        \find(pseqPerm<E>(s1, s2) ==>)
        \add(pseqPerm<E>(s1, s3) ==>)
    };

    // DB: changed 25/10/2013 to be applied on RHS
    \lemma
    pseqPermRefl {
        \schemaVar \term PSeq<E> s;
        \find(pseqPerm<E>(s, s))
        \replacewith(true)
        \heuristics(concrete)
    };

    pseqPermEmpty1 {
        \schemaVar \term PSeq<E> s;
        \find(pseqPerm<E>(pseqEmpty<E>, s))
        \replacewith(pseqEmpty<E> = s)
        \heuristics(simplify)
        \displayname "seqPermEmpty"
    };

    pseqPermEmpty2 {
        \schemaVar \term PSeq<E> s;
        \find(pseqPerm<E>(s, pseqEmpty<E>))
        \replacewith(pseqEmpty<E> = s)
        \heuristics(simplify)
        \displayname "seqPermEmpty"
    };

    pseqNPermSwapNPerm {
        \schemaVar \term PSeq<int> s1;
        \schemaVar \variables int iv, jv;

        \find(pseqNPerm(s1) ==>)
        \varcond(\notFreeIn(iv, s1), \notFreeIn(jv, s1))

        \add(\forall iv; (\forall jv; (
                    (0 <= iv & 0 <= jv & iv < pseqLen<int>(s1) & jv < pseqLen<int>(s1))
                    -> pseqNPerm(pseqSwap<int>(s1, iv, jv)))) ==>)

    };

    // changed; proven in KeY -- DB 29/10/2013
    pseqNPermEmpty {
        \find(pseqNPerm(pseqEmpty<int>))
        \replacewith(true)
        \heuristics(concrete)
    };

    // changed; proven in KeY -- DB 29/10/2013
    pseqNPermSingletonConrete {
        \find(pseqNPerm(pseqSingleton<int>(0)))
        \replacewith(true)
        \heuristics(concrete)
    };

    // changed; proven in KeY -- DB 29/10/2013
    pseqNPermSingleton {
        \schemaVar \term int si;
        \find(pseqNPerm(pseqSingleton<int>(si)))
        \replacewith(si = 0)
        \heuristics(simplify)
    };

    pseqNPermComp {
        \schemaVar \term PSeq<int> s1, s2;
        \schemaVar \variables int u;
        \assumes(pseqNPerm(s2) & pseqLen<int>(s1) = pseqLen<int>(s2) ==>)
        \find(pseqNPerm(s1) ==>)
        \varcond(\notFreeIn(u, s1), \notFreeIn(u, s2))

        \add(pseqNPerm(pseqDef<int>{u;}(0, pseqLen<int>(s1),
                    pseqGet<int>(s1, pseqGet<int>(s2, u)))) ==>)

    };

    pseqGetSInvS {
        \schemaVar \term PSeq<int> s;
        \schemaVar \term int t;

        \find(pseqGet<int>(s, pseqGet<int>(pseqNPermInv(s), t)))
        \replacewith(t);
        \add( ==> pseqNPerm(s) & 0 <= t & t < pseqLen<int>(s))

        // \heuristics(simplify)

    };

    pseqNPermInvNPermLeft {
        \schemaVar \term PSeq<int> s1;

        \find(pseqNPerm(s1) ==>)
        \add(pseqNPerm(pseqNPermInv(s1)) ==>)
    };

    // DB: changed 25/10/2013 to be applied on RHS
    pseqPermSym {
        \schemaVar \term PSeq<E> s1, s2;
        \find(pseqPerm<E>(s1, s2))
        \replacewith(pseqPerm<E>(s2, s1))
    };

    pseqNPermInvNPermReplace {
        \schemaVar \term PSeq<int> s1;

        \find(pseqNPerm(pseqNPermInv(s1)))
        \replacewith(pseqNPerm(s1))
    };

    pseqPermConcatFW {
        \schemaVar \term PSeq<E> s1, s2, t1, t2;

        \assumes(pseqPerm<E>(s1, t1) ==>)
        \find(pseqPerm<E>(s2, t2) ==>)
        \add(pseqPerm<E>(pseqConcat<E>(s1, s2), pseqConcat<E>(t1, t2)) ==>)
    };

    pseqPermConcatBW {
        \schemaVar \term PSeq<E> s1, s2, t1, t2;

        \assumes(pseqPerm<E>(s1, t1) ==>)
        \find( ==> pseqPerm<E>(pseqConcat<E>(s1, s2), pseqConcat<E>(t1, t2)))
        \replacewith( ==> pseqPerm<E>(s2, t2))

        \heuristics(simplify)
    };

    \lemma
    pseqPermSplit {
        \schemaVar \term PSeq<E> s1, s2, t1, t2;
        \find( ==> pseqPerm<E>(pseqConcat<E>(s1, s2), pseqConcat<E>(t1, t2)))
        \replacewith( ==> pseqPerm<E>(s1, t1) & pseqPerm<E>(s2, t2))
    };

    pseqnormalizeDef {
        \schemaVar \term PSeq<E> s1;
        \schemaVar \term int le, ri;
        \schemaVar \term E t;
        \schemaVar \variables int u;

        \find(pseqDef<E>{u;}(le, ri, t))
        \varcond(\notFreeIn(u, le), \notFreeIn(u, ri))
        \replacewith(\if(le < ri)
                \then(pseqDef<E>{u;}(0, (ri - le), ({\subst u; (u + le)}t)))
                \else(pseqEmpty<E>))

    };

    \lemma
    pseqNPermRight {
        \schemaVar \term PSeq<int> s;
        \schemaVar \variables int iv, jv;

        \find( ==> pseqNPerm(s))
        \varcond(\notFreeIn(iv, s), \notFreeIn(jv, s))
        \add( ==> \forall iv; (\forall jv; (
                    (0 <= iv & iv < pseqLen<int>(s) & 0 <= jv & jv < pseqLen<int>(s)
                        & pseqGet<int>(s, iv) = pseqGet<int>(s, jv))
                    -> iv = jv))
            & \forall iv; (0 <= iv & iv < pseqLen<int>(s) -> 0 <= pseqGet<int>(s, iv) & pseqGet<int>(s, iv) < pseqLen<int>(s))
            & \forall iv; (0 <= iv & iv < pseqLen<int>(s) -> instance<int>(pseqGet<int>(s, iv)) = TRUE))
    };

    \lemma
    pseqPermFromSwap {
        \schemaVar \term PSeq<E> s1, s2, t1, t2;
        \schemaVar \variables int iv, jv;

        \assumes(pseqPerm<E>(s1, t1) ==>)
        \find( ==> pseqPerm<E>(s2, t2))
        \varcond(
            \notFreeIn(iv, s1),
            \notFreeIn(iv, s2),
            \notFreeIn(iv, t1),
            \notFreeIn(iv, t2),
            \notFreeIn(jv, s1),
            \notFreeIn(jv, s2),
            \notFreeIn(jv, t1),
            \notFreeIn(jv, t2))
        \replacewith( ==> t1 = t2 &
            \exists iv; \exists jv; (0 <= iv & 0 <= jv & iv < s2.length & jv < s2.length &
                s1 = pseqSwap<E>(s2, iv, jv)))
    };

    \lemma
    pseqSwapPreservesPSeqPerm {
        \schemaVar \term PSeq<E> s;
        \schemaVar \term int x;
        \schemaVar \term int y;

        \find(==> pseqPerm<E>(s, pseqSwap<E>(s, x, y)))
        \add( ==> 0 <= x & x < pseqLen<E>(s) & 0 <= y & y < pseqLen<E>(s))
        \heuristics(simplify_enlarging)
        \generate(\EQ(pseqSwap<E>(s, x, y)))
    };

    /* pseqPermOrder {
     \schemaVar \term PSeq<E> commEqLeft, commEqRight;
     \find(pseqPerm<E>(commEqLeft, commEqRight))
     \replacewith(pseqPerm<E>(commEqRight, commEqLeft))
     \heuristics(order_terms)
    };*/

    // These rules are variants of seqPermTrans used to prove transitive
    // seqPerm challenges automatically.

    \lemma
    pseqPermTransAlt0 {
        \schemaVar \term PSeq<E> s1, s2, s3, x, y;

        \assumes(pseqPerm<E>(s2, s3) ==> pseqPerm<E>(x, y))
        \find(pseqPerm<E>(s1, s2) ==>)
        \add(pseqPerm<E>(s1, s3) ==>)
        \heuristics(inReachableStateImplication)
        \displayname "seqPermTrans"
    };

    \lemma
    pseqPermTransAlt1 {
        \schemaVar \term PSeq<E> a, b, c, x, y;
        \assumes(pseqPerm<E>(a, b) ==> pseqPerm<E>(x, y))
        // apply this rule only if there is a seqPerm goal to prove!
        \find(pseqPerm<E>(a, c) ==>)
        \add(pseqPerm<E>(b, c) ==>)
        \heuristics(inReachableStateImplication)
        \displayname "seqPermTrans"
    };

    \lemma
    pseqPermTransAlt2 {
        \schemaVar \term PSeq<E> a, b, c, x, y;
        \assumes(pseqPerm<E>(a, c) ==> pseqPerm<E>(x, y))
        // apply this rule only if there is a seqPerm goal to prove!
        \find(pseqPerm<E>(b, c) ==>)
        \add(pseqPerm<E>(a, b) ==>)
        \heuristics(inReachableStateImplication)
        \displayname "seqPermTrans"
    };

    \lemma
    pseqPermTransAlt3 {
        \schemaVar \term PSeq<E> a, b, c, x, y;
        \assumes(pseqPerm<E>(a, c) ==> pseqPerm<E>(x, y))
        // apply this rule only if there is a seqPerm goal to prove!
        \find(pseqPerm<E>(b, a) ==>)
        \add(pseqPerm<E>(b, c) ==>)
        \heuristics(inReachableStateImplication)
        \displayname "seqPermTrans"
    };

    // Proven by ulbrich in Isabelle/HOL
    pseqPermCountsInt {
        \schemaVar \term PSeq<E> s1, s2;
        \schemaVar \variables int iv;
        \schemaVar \variables E element;

        \find(pseqPerm<E>(s1, s2))

        \varcond(
            \notFreeIn(element, s1, s2),
            \notFreeIn(iv, s1, s2)
        )

        \replacewith(
            (\forall element;
                bsum{iv;}(0, s1.length, \if(pseqGet<E>(s1, iv) = element) \then(1) \else(0)) =
                bsum{iv;}(0, s2.length, \if(pseqGet<E>(s2, iv) = element) \then(1) \else(0))
            )
        )
    };

    \lemma
    pseqPermForall {
        \schemaVar \term PSeq<E> s1;
        \schemaVar \term PSeq<E> s2;
        \schemaVar \formula phi;
        \schemaVar \variable int iv;
        \schemaVar \variable E x;
        \assumes(pseqPerm<E>(s1, s2) ==>)
        \varcond(\notFreeIn(iv, phi), \notFreeIn(iv, s1), \notFreeIn(iv, s2))
        \add(\forall iv; (0 <= iv & iv < pseqLen<E>(s1) -> {\subst x; pseqGet<E>(s1, iv)}phi)
            <->
            \forall iv; (0 <= iv & iv < pseqLen<E>(s1) -> {\subst x; pseqGet<E>(s2, iv)}phi) ==>)
    };

    \lemma
    pseqPermExists {
        \schemaVar \term PSeq<E> s1;
        \schemaVar \term PSeq<E> s2;
        \schemaVar \formula phi;
        \schemaVar \variable int iv;
        \schemaVar \variable E x;
        \assumes(pseqPerm<E>(s1, s2) ==>)
        \varcond(\notFreeIn(iv, phi), \notFreeIn(iv, s1), \notFreeIn(iv, s2))
        \add(\exists iv; (0 <= iv & iv < pseqLen<E>(s1) & {\subst x; pseqGet<E>(s1, iv)}phi)
            <->
            \exists iv; (0 <= iv & iv < pseqLen<E>(s1) & {\subst x; pseqGet<E>(s2, iv)}phi) ==>)
    };
}
