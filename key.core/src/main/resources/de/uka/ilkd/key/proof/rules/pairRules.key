\sorts {
    \generic E1, E2;
}

\rules {
    pairAxiom {
        \schemaVar \term Pair<E1, E2> p;
        \schemaVar \variables E1 e1;
        \schemaVar \variables E2 e2;

        \find(p)
        \varcond(\notFreeIn(e1, p), \notFreeIn(e2, p))
        \add(\exists e1; \exists e2; (pair<E1, E2>(e1, e2) = p) ==>)
    }
}
