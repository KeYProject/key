/** Additional rules for the size of maps.
 * @author Kai Wallisch, Daniel Drodt
 */

\schemaVariables {
    \term PMap<K, V> m, m0, m1;
    \term K key;
    \term V value;
    \variables K kv;
    \variables V vv;
}

\rules {
    // --------------------------------------------------------------------------
    // isFinite axiom
    // --------------------------------------------------------------------------

    defPMapIsFinite {
        \schemaVar \variables int ix;
        \schemaVar \variables PSeq<K> s;
        \find(pmapIsFinite<K, V>(m))
        \varcond(\notFreeIn(kv, m), \notFreeIn(s, m))
        \replacewith(\exists s;
            (\forall kv;
                (
                    (pmapInDomain<K, V>(m, kv)
                        -> (\exists ix;
                                (0 <= ix & ix < pseqLen<K>(s) & pseqGet<K>(s, ix) = kv &
                                    (\forall int jx;
                                        (0 <= jx & jx < pseqLen<K>(s) & ix != jx
                                            -> pseqGet<K>(s, jx) != kv)
                                    )
                                )
                            )
                    )
                    & (
                        (\exists ix; (0 <= ix & ix < pseqLen<K>(s) & pseqGet<K>(s, ix) = kv))
                        -> pmapInDomain<K, V>(m, kv)
                      )
                )
            )
        )
    };

    // --------------------------------------------------------------------------
    // isFinite derived rules
    // --------------------------------------------------------------------------

    \lemma
    isFiniteOfPMapEmpty {
        \find(pmapIsFinite<K, V>(pmapEmpty<K, V>))
        \replacewith(true)
        \heuristics(simplify)
        \generate(\EQ(pmapEmpty<K, V>)))
    };

    \lemma
    isFiniteOfPMapRemove {
        \find(pmapIsFinite<K, V>(pmapRemove<K, V>(m, key)))
        \replacewith(pmapIsFinite<K, V>(m))
        \heuristics(simplify)
        \generate(\EQ(pmapRemove<K, V>(m, key))))
    };

    \lemma
    isFiniteOfPMapUpdate {
        \find(pmapIsFinite<K, V>(pmapUpdate<K, V>(m, key, value)))
        \replacewith(pmapIsFinite<K, V>(m))
        \heuristics(simplify)
        \generate(\EQ(pmapUpdate<K, V>(m, key, value))))
    };

    \lemma
    isFiniteOfPMapSingleton {
        \find(pmapIsFinite<K, V>(pmapSingleton<K, V>(key, value)))
        \replacewith(true)
        \heuristics(simplify)
        \generate(\EQ(pmapSingleton<K, V>(key, value))))
    };

    \lemma
    isFiniteOfPSeq2PMap {
        \schemaVar \term PSeq<V> s;
        \find(pmapIsFinite<int, V>(pseq2pmap<V>(s)))
        \replacewith(true)
        \heuristics(simplify)
        \generate(\EQ(pseq2pmap<V>(s))))
    };

    // --------------------------------------------------------------------------
    // mapSize axioms
    // --------------------------------------------------------------------------

    sizeOfPMapEmpty {
        \find(pmapSize<K, V>(pmapEmpty<K, V>))
        \replacewith(0)
        \heuristics(simplify)
        \generate(\EQ(pmapEmpty<K, V>)))
    };

    sizeOfPMapRemove {
        \find(pmapSize<K, V>(pmapRemove<K, V>(m, key)))
        \add(pmapIsFinite<K, V>(m) -> (
                pmapSize<K, V>(pmapRemove<K, V>(m, key)) =
                \if(pmapInDomain<K, V>(m, key)) \then(pmapSize<K, V>(m) - 1) \else(pmapSize<K, V>(m))
            ) ==>)
        \heuristics(inReachableStateImplication)
    };

    // --------------------------------------------------------------------------
    // mapSize derived rules
    // --------------------------------------------------------------------------

    sizeOfPMapUpdate {
        \find(pmapSize<K, V>(pmapUpdate<K, V>(m, key, value)))
        \add(pmapIsFinite<K, V>(m) -> (
                pmapSize<K, V>(pmapUpdate<K, V>(m, key, value)) =
                \if(pmapInDomain<K, V>(m, key)) \then(pmapSize<K, V>(m)) \else(pmapSize<K, V>(m) + 1)
            ) ==>)
        \heuristics(inReachableStateImplication)
    };

    sizeOfPMapSingleton {
        \find(pmapSize<K, V>(pmapSingleton<K, V>(key, value)))
        \replacewith(1)
        \heuristics(simplify)
        \generate(\EQ(pmapSingleton<K, V>(key, value))))
    };

    sizeOfPSeq2PMap {
        \schemaVar \term PSeq<V> s;
        \find(pmapSize<int, V>(pseq2pmap<V>(s)))
        \replacewith(pseqLen<V>(s))
        \heuristics(simplify)
        \generate(\EQ(pseq2pmap<V>(s))))
    };

    pmapSizeNotNegativeForFinitePMaps {
        \find(pmapSize<K, V>(m))
        \add(pmapIsFinite<K, V>(m) -> (pmapSize<K, V>(m) >= 0) ==>)
        \heuristics(inReachableStateImplication)
    };
}
