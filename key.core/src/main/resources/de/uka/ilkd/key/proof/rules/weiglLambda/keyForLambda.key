// keyForLambda.key
//
// Taclets for the explicit weakest-precondition predicate behind the JML escape
// '\dl_wp_apply' (Csiky, "Specification and deductive verification of Java
// programs with lambda expressions", bachelor thesis, ch. 5 + appendix A.1,
// adapted to current KeY syntax).
//
//   JML usage:     requires \dl_wp_apply(this, arg);
//   JavaDL:        wp_apply(heap, this, arg)
//   meaning:       calling the functional method of the lambda ('this'/'f'),
//                  no exception, terminates.
//
// Loading: this file is intentionally NOT part of the default rule base. Load
// it for a proof (e.g. as additional rules of the proof obligation) and make
// sure it is parsed BEFORE the JML contracts of the project are translated:
// the '\predicates' declaration below registers the symbol 'wp_apply' and the
// JML translation (JmlTermFactory.createDlEscapeOnDemand) transparently
// re-uses it. Declaring it after a contract has already created the predicate
// on demand would abort with "Predicate 'wp_apply' is already defined!".
//
// Signature: 'any' is used for the functional interface and the argument, so
// that the taclets match whichever concrete instantiation the translation
// picks for the project's functional interface
// (wp_apply(Heap, <Interface>, <arg sorts>...)). The heap and the argument of
// the modality in wp_def use the concrete interface 'IntFunction' as in
// appendix A.2 of the thesis; if the project uses a different functional
// interface, adapt the schema variable types and the '\new' varcond below.

\predicates {
    // Weakest precondition of "call the functional method, no exception,
    // terminates". h is the heap the call is evaluated in, f the functional
    // interface object, a the argument.
    wp_apply(Heap, any, any);
}

\rules {

    // From Csiky appendix A.1. If the same functional method is executed in two
    // "sufficiently equal" heaps h1, h2, then the weakest precondition is the
    // same in both. This is the useDependencyContract-style rule with an empty
    // dependency set: the frame condition states that w.r.t. h1 all locations of
    // created objects keep their value in h2, and f is created in h1.
    wp_dep_contract {
        \schemaVar \term Heap h1;
        \schemaVar \term Heap h2;
        \schemaVar \term java.lang.Object f;
        \schemaVar \term any a;

        \schemaVar \variables Object ov;
        \schemaVar \variables Field fv;

        \find(wp_apply(h1, f, a))

        \varcond(
            \notFreeIn(ov, h1),
            \notFreeIn(fv, h1),
            \notFreeIn(ov, h2),
            \notFreeIn(fv, h2)
        )

        \replacewith(wp_apply(h2, f, a))

        \add(==> wellFormed(h1)
            & wellFormed(h2)
            & f != null
            & select<boolean>(h1, f, java.lang.Object::#$created) = TRUE
            & (\forall ov; \forall fv; (
                select<boolean>(h1, ov, java.lang.Object::#$created) = FALSE
                | select<any>(h1, ov, fv) = select<any>(h2, ov, fv))))
    }

    // From Csiky appendix A.1 (adapted to the 'kp_apply' signature above).
    // Expands the predicate into the explicit dynamic-logic formulation: run
    // f.apply(a) in heap h in a totally-correct (terminating) box modality and
    // require that no exception is thrown.
    wp_def {
        \schemaVar \term Heap h;
        // FIXME(weigl/lambda): 'IntFunction' must be the functional interface
        // present in the loaded Java model (as in appendix A.2 of the thesis);
        // adapt the name if the project uses a different interface.
        \schemaVar \term IntFunction f;
        \schemaVar \term int a;

        \schemaVar \program Variable #a;
        \schemaVar \program Variable #exc;
        \schemaVar \program Variable #f;

        \find(wp_apply(h, f, a))

        \varcond(
            \new(#a, int),
            \new(#exc, java.lang.Throwable),
            \new(#f, IntFunction)
        )

        \add(wp_apply(h, f, a) <-> (
            { heap := h || #a := a || #exc := null || #f := f }
            \<{ try { #f.apply(#a); }
                catch (java.lang.Throwable e) { #exc = e; } }\>
            (#exc = null)) ==>)
    }
}
