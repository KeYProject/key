\schemaVariables {
    \term Map<K, V> m, m0, m1;
    \term K key, key1;
    \term V value;
    \term boolean b;
    \variables K kv;
    \variables V vv;
}

\rules {
    // --------------------------------------------------------------------------
    // axioms
    // --------------------------------------------------------------------------

    // Added by Kai Wallisch
    defMapEquality {
        \find(m0 = m1)
        \varcond(\notFreeIn(kv, m0, m1))
        \replacewith(\forall kv; ((inDomain<K, V>(m0, kv) <-> inDomain<K, V>(m1, kv)) &
                (inDomain<K, V>(m0, kv) -> mapGet<K, V>(m0, kv) = mapGet<K, V>(m1, kv))))
    };

    inDomainOfMapForeach {
        \find(inDomain<K, V>(mapForeach<K, V>{kv;}(b, value), key))
        \replacewith({\subst kv; key}b = TRUE)
        \heuristics(simplify)
    };

    getOfMapForeach {
        \find(mapGet<K, V>(mapForeach<K, V>{kv;}(b, value), key))
        \replacewith(\if(inDomain<K, V>(mapForeach<K, V>{kv;}(b, value), key))
                \then({\subst kv; key}value)
                \else(mapUndef<V>))
        \heuristics(simplify_enlarging)
    };

    // --------------------------------------------------------------------------
    // definitions (conservative extensions)
    // --------------------------------------------------------------------------

    defMapEmpty {
        \find(mapEmpty<K, V>)
        \replacewith(mapForeach<K, V>{kv;}(FALSE, mapUndef<V>))
    };

    defMapSingleton {
        \find(mapSingleton<K, V>(key, value))
        \varcond(\notFreeIn(kv, key, value))
        \replacewith(mapForeach<K, V>{kv;}(
                \if(kv = key) \then(TRUE) \else(FALSE), value)
        )
    };

    defMapOverride {
        \find(mapOverride<K, V>(m0, m1))
        \varcond(\notFreeIn(kv, m0, m1))
        \replacewith(mapForeach<K, V>{kv;}(
                \if(inDomain<K, V>(m0, kv) | inDomain<K, V>(m1, kv)) \then(TRUE) \else(FALSE),
                \if(inDomain<K, V>(m1, kv))
                    \then(mapGet<K, V>(m1, kv)) \else(mapGet<K, V>(m0, kv))
            ))
    };

    defPSeq2Map {
        \schemaVar \term PSeq<V> s;
        \schemaVar \variables int ix;
        \find(pseq2map<V>(s))
        \varcond(\notFreeIn(ix, s))
        \replacewith(mapForeach<int, V>{ix;}(
                \if(0 <= ix & ix < pseqLen<V>(s)) \then(TRUE) \else(FALSE),
                pseqGet<V>(s, ix)
            ))
    };

    // Added by Kai Wallisch
    defMapUpdate {
        \find(mapUpdate<K, V>(m, key, value))
        \varcond(\notFreeIn(kv, m, key, value))
        \replacewith(mapForeach<K, V>{kv;}(
                \if(inDomain<K, V>(m, kv) | kv = key)
                    \then(TRUE)
                    \else(FALSE),
                \if(kv = key)
                    \then(value)
                    \else(mapGet<K, V>(m, kv))
            ))
    };

    // Added by Kai Wallisch
    defMapRemove {
        \find(mapRemove<K, V>(m, key))
        \varcond(\notFreeIn(kv, m, key))
        \replacewith(mapForeach<K, V>{kv;}(
                \if(inDomain<K, V>(m, kv) & kv != key)
                    \then(TRUE)
                    \else(FALSE),
                mapGet<K, V>(m, kv)
            ))
    };

    // --------------------------------------------------------------------------
    // derived map equality rules (proven sound in KeY)
    // --------------------------------------------------------------------------

    // Added by Kai Wallisch
    \lemma
    mapEqualityRight {
        \find( ==> m0 = m1)
        \varcond(\notFreeIn(kv, m0, m1))
        \replacewith( ==> \forall kv; ((inDomain<K, V>(m0, kv) <-> inDomain<K, V>(m1, kv)) &
                (inDomain<K, V>(m0, kv) -> mapGet<K, V>(m0, kv) = mapGet<K, V>(m1, kv))))
        \heuristics(simplify_enlarging)
    };

    // Added by Kai Wallisch
    \lemma
    mapUpdateUnchanged {
        \find(m = mapUpdate<K, V>(m, key, value))
        \replacewith(inDomain<K, V>(m, key) & mapGet<K, V>(m, key) = value)
        \heuristics(simplify_enlarging)
    };

    // Added by Kai Wallisch
    \lemma
    mapUpdateUnchanged2 {
        \find(mapUpdate<K, V>(m, key, value) = m)
        \replacewith(inDomain<K, V>(m, key) & mapGet<K, V>(m, key) = value)
        \heuristics(simplify_enlarging)
    };

    // Added by Kai Wallisch
    \lemma
    mapRemoveUnchanged {
        \find(m = mapRemove<K, V>(m, key))
        \replacewith(!inDomain<K, V>(m, key))
        \heuristics(simplify_enlarging)
    };

    // Added by Kai Wallisch
    \lemma
    mapRemoveUnchanged2 {
        \find(mapRemove<K, V>(m, key) = m)
        \replacewith(!inDomain<K, V>(m, key))
        \heuristics(simplify_enlarging)
    };

    // --------------------------------------------------------------------------
    // derived inDomain rules (proven sound in KeY)
    // --------------------------------------------------------------------------
    \lemma
    inDomainOfMapEmpty {
        \find(inDomain<K, V>(mapEmpty<K, V>, key))
        \replacewith(false)
        \heuristics(concrete)
        \generate(\EQ(mapEmpty<K, V>))
    };

    \lemma
    inDomainOfMapSingleton {
        \find(inDomain<K, V>(mapSingleton<K, V>(key, value), key1))
        \replacewith(key = key1)
        \heuristics(simplify)
        \generate(\EQ(mapSingleton<K, V>(key, value)))
    };

    \lemma
    inDomainOfMapOverride {
        \find(inDomain<K, V>(mapOverride<K, V>(m0, m1), key))
        \replacewith(inDomain<K, V>(m0, key) | inDomain<K, V>(m1, key))
        \heuristics(simplify)
        \generate(\EQ(mapOverride<K, V>(m0, m1)))
    };

    \lemma
    inDomainOfPSeq2Map {
        \schemaVar \term PSeq<V> s;
        \schemaVar \term int ki;
        \find(inDomain<int, V>(pseq2map<V>(s), ki))
        \replacewith(0 <= ki & ki < pseqLen<V>(s))
        \heuristics(simplify)
        \generate(\EQ(pseq2map<V>(s)))
    };

    // Added by Kai Wallisch
    \lemma
    inDomainOfMapUpdate {
        \find(inDomain<K, V>(mapUpdate<K, V>(m, key, value), key1))
        \replacewith(inDomain<K, V>(m, key1) | (key1 = key))
        \heuristics(simplify_enlarging)
        \generate(\EQ(mapUpdate<K, V>(m, key, value)))
    };

    // Added by Kai Wallisch
    \lemma
    inDomainOfMapRemove {
        \find(inDomain<K, V>(mapRemove<K, V>(m, key), key1))
        \replacewith(inDomain<K, V>(m, key1) & (key1 != key))
        \heuristics(simplify_enlarging)
        \generate(\EQ(mapRemove<K, V>(m, key)))
    };

    // Added by Kai Wallisch
    mapGetNotInDomain {
        \assumes(==> inDomain<K, V>(m, key))
        \find(mapGet<K, V>(m, key))
        \replacewith(mapUndef<V>)
        \heuristics(simplify)
    };

    \lemma
    inDomainConcrete {
        \assumes( ==> mapUndef<V> = value)
        \find(mapGet<K, V>(m, key) = value ==>)
        \add(inDomain<K, V>(m, key) ==>)
        \heuristics(inReachableStateImplication)
    };

    // --------------------------------------------------------------------------
    // derived mapGet rules (proven sound in KeY)
    // --------------------------------------------------------------------------

    // Added by Kai Wallisch
    \lemma
    getOfMapEmpty {
        \find(mapGet<K, V>(mapEmpty<K, V>, key))
        \replacewith(mapUndef<V>)
        \heuristics(simplify)
        \generate(\EQ(mapEmpty<K, V>))
    };

    \lemma
    getOfMapSingleton {
        \find(mapGet<K, V>(mapSingleton<K, V>(key, value), key1))
        \replacewith(\if(key = key1) \then(value) \else(mapUndef<V>))
        \heuristics(simplify)
        \generate(\EQ(mapSingleton<K, V>(key, value)))
    };

    \lemma
    getOfMapOverride {
        \find(mapGet<K, V>(mapOverride<K, V>(m0, m1), key))
        \replacewith(\if(inDomain<K, V>(m1, key))
                \then(mapGet<K, V>(m1, key)) \else(mapGet<K, V>(m0, key)))
        \heuristics(simplify_enlarging)
        \generate(\EQ(mapOverride<K, V>(m0, m1)))
    };

    \lemma
    getOfPSeq2Map {
        \schemaVar \term PSeq<V> s;
        \schemaVar \term int ki;
        \find(mapGet<int, V>(pseq2map<V>(s), ki))
        \replacewith(\if(0 <= ki & ki < pseqLen<V>(s))
                \then(pseqGet<V>(s, ki)) \else(mapUndef<V>))
        \heuristics(simplify_enlarging)
        \generate(\EQ(pseq2map<V>(s)))
    };

    // Added by Kai Wallisch
    \lemma
    getOfMapUpdate {
        \find(mapGet<K, V>(mapUpdate<K, V>(m, key, value), key1))
        \replacewith(\if(key1 = key) \then(value) \else(mapGet<K, V>(m, key1)))
        \heuristics(simplify_enlarging)
        \generate(\EQ(mapUpdate<K, V>(m, key, value)))
    };

    // Added by Kai Wallisch
    \lemma
    getOfMapRemove {
        \find(mapGet<K, V>(mapRemove<K, V>(m, key), key1))
        \replacewith(\if(key1 = key) \then(mapUndef<V>) \else(mapGet<K, V>(m, key1)))
        \heuristics(simplify_enlarging)
        \generate(\EQ(mapRemove<K, V>(m, key)))
    };
}
