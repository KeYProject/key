/** Additional rules for the size of maps.
 * @author Kai Wallisch, Daniel Drodt
 */

\schemaVariables {
    \term Map<K, V> m, m0, m1;
    \term K key;
    \term V value;
    \variables K kv;
    \variables V vv;
}

\rules {
    // --------------------------------------------------------------------------
    // isFinite axiom
    // --------------------------------------------------------------------------

    defIsFinite {
        \schemaVar \variables int ix;
        \schemaVar \variables PSeq<K> s;
        \find(isFinite<K, V>(m))
        \varcond(\notFreeIn(kv, m), \notFreeIn(s, m))
        \replacewith(\exists s;
            (\forall kv;
                (
                    (inDomain<K, V>(m, kv)
                        -> (\exists ix;
                                (0 <= ix & ix < pseqLen<K>(s) & pseqGet<K>(s, ix) = kv &
                                    (\forall int jx;
                                        (0 <= jx & jx < pseqLen<K>(s) & ix != jx
                                            -> pseqGet<K>(s, jx) != kv)
                                    )
                                )
                            )
                    )
                    & (
                        (\exists ix; (0 <= ix & ix < pseqLen<K>(s) & pseqGet<K>(s, ix) = kv))
                        -> inDomain<K, V>(m, kv)
                      )
                )
            )
        )
    };

    // --------------------------------------------------------------------------
    // isFinite derived rules
    // --------------------------------------------------------------------------

    \lemma
    isFiniteOfMapEmpty {
        \find(isFinite<K, V>(mapEmpty<K, V>))
        \replacewith(true)
        \heuristics(simplify)
        \generate(\EQ(mapEmpty<K, V>))
    };

    \lemma
    isFiniteOfMapRemove {
        \find(isFinite<K, V>(mapRemove<K, V>(m, key)))
        \replacewith(isFinite<K, V>(m))
        \heuristics(simplify)
        \generate(\EQ(mapRemove<K, V>(m, key)))
    };

    \lemma
    isFiniteOfMapUpdate {
        \find(isFinite<K, V>(mapUpdate<K, V>(m, key, value)))
        \replacewith(isFinite<K, V>(m))
        \heuristics(simplify)
        \generate(\EQ(mapUpdate<K, V>(m, key, value)))
    };

    \lemma
    isFiniteOfMapSingleton {
        \find(isFinite<K, V>(mapSingleton<K, V>(key, value)))
        \replacewith(true)
        \heuristics(simplify)
        \generate(\EQ(mapSingleton<K, V>(key, value)))
    };

    \lemma
    isFiniteOfPSeq2Map {
        \schemaVar \term PSeq<V> s;
        \find(isFinite<int, V>(pseq2map<V>(s)))
        \replacewith(true)
        \heuristics(simplify)
        \generate(\EQ(pseq2map<V>(s)))
    };

    // --------------------------------------------------------------------------
    // mapSize axioms
    // --------------------------------------------------------------------------

    sizeOfMapEmpty {
        \find(mapSize<K, V>(mapEmpty<K, V>))
        \replacewith(0)
        \heuristics(simplify)
        \generate(\EQ(mapEmpty<K, V>))
    };

    sizeOfMapRemove {
        \find(mapSize<K, V>(mapRemove<K, V>(m, key)))
        \add(isFinite<K, V>(m) -> (
                mapSize<K, V>(mapRemove<K, V>(m, key)) =
                \if(inDomain<K, V>(m, key)) \then(mapSize<K, V>(m) - 1) \else(mapSize<K, V>(m))
            ) ==>)
        \heuristics(inReachableStateImplication)
    };

    // --------------------------------------------------------------------------
    // mapSize derived rules
    // --------------------------------------------------------------------------

    sizeOfMapUpdate {
        \find(mapSize<K, V>(mapUpdate<K, V>(m, key, value)))
        \add(isFinite<K, V>(m) -> (
                mapSize<K, V>(mapUpdate<K, V>(m, key, value)) =
                \if(inDomain<K, V>(m, key)) \then(mapSize<K, V>(m)) \else(mapSize<K, V>(m) + 1)
            ) ==>)
        \heuristics(inReachableStateImplication)
    };

    sizeOfMapSingleton {
        \find(mapSize<K, V>(mapSingleton<K, V>(key, value)))
        \replacewith(1)
        \heuristics(simplify)
        \generate(\EQ(mapSingleton<K, V>(key, value)))
    };

    sizeOfPSeq2Map {
        \schemaVar \term PSeq<V> s;
        \find(mapSize<int, V>(pseq2map<V>(s)))
        \replacewith(pseqLen<V>(s))
        \heuristics(simplify)
        \generate(\EQ(pseq2map<V>(s)))
    };

    mapSizeNotNegativeForFiniteMaps {
        \find(mapSize<K, V>(m))
        \add(isFinite<K, V>(m) -> (mapSize<K, V>(m) >= 0) ==>)
        \heuristics(inReachableStateImplication)
    };
}
