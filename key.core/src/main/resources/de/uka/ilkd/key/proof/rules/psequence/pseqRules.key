// This file contains only the RULES for the definitional
// extension of the sequence datatype.
// The core theory is contained in file  seqCoreRules.key
// Find the DECLARATIONS in file seq.key.
// RULES for permutations are contained in the file seqPerm.key.

\sorts {
    \generic alpha, beta;
}

\rules(sequences:on) {
    // --------------------------------------------------------------------------
    //  These taclets were not part of the original PSeq<E> axiomatization by
    //  B.Weiss
    //  These taclets extend the signature of the core theory by indroducing
    //  function  symbols via explicit definition.
    //  Consistency of the extended theory is thus guaranteed by
    //  the Theorem on  conservative extentions.
    // --------------------------------------------------------------------------


    pseqDefOfEmpty {
        \schemaVar \term E te;
        \schemaVar \variables int uSub;

        \find(pseqEmpty<E>)

        \varcond(\notFreeIn(uSub, te))
        \replacewith(pseqDef<E>{uSub;}(0, 0, te))
    };

    defOfPSeqSingleton {
        \schemaVar \term E x;
        \schemaVar \variables int uSub;

        \find(pseqSingleton<E>(x))

        \varcond(\notFreeIn(uSub, x))
        \replacewith(pseqDef<E>{uSub;}(0, 1, x))
    };

    defOfPSeqConcat {
        \schemaVar \term PSeq<E> seq1, seq2;
        \schemaVar \variables int uSub;

        \find(pseqConcat<E>(seq1, seq2))

        \varcond(\notFreeIn(uSub, seq1),
            \notFreeIn(uSub, seq2))
        \replacewith(pseqDef<E>{uSub;}(0, pseqLen<E>(seq1) + pseqLen<E>(seq2),
                \if(uSub < pseqLen<E>(seq1))
                    \then(pseqGet<E>(seq1, uSub))
                    \else(pseqGet<E>(seq2, uSub - pseqLen<E>(seq1)))))

    };

    // --------------------------------------------------------------------
    //  This definition of "seqSub" differs from the original one.
    //  Now pseqSub<E>(seq,from,from) is the empty sequence, previously it
    //  was the singleton <seq(from)>.
    //  The new semantics however is in line with all other definitions
    //  involving a lower and and upper bound. The upper bound is always
    //  strict.
    // --------------------------------------------------------------------

    defOfPSeqSub {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term int from, to;
        \schemaVar \variables int uSub;

        \find(pseqSub<E>(seq, from, to))
        \varcond(\notFreeIn(uSub, seq),
            \notFreeIn(uSub, from),
            \notFreeIn(uSub, to))
        \replacewith(pseqDef<E>{uSub;}(from, to, pseqGet<E>(seq, uSub)))

    };

    defOfPSeqReverse {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \variables int uSub;

        \find(pseqReverse<E>(seq))

        \varcond(\notFreeIn(uSub, seq))
        \replacewith(pseqDef<E>{uSub;}(0, pseqLen<E>(seq), pseqGet<E>(seq, pseqLen<E>(seq) - uSub - 1)))

    };

    defOfPSeqUpd {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term int idx;
        \schemaVar \term E value;
        \schemaVar \variables int uSub;

        \find(pseqUpd<E>(seq, idx, value))

        \varcond(\notFreeIn(uSub, idx), \notFreeIn(uSub, value), \notFreeIn(uSub, seq))
        \replacewith(pseqDef<E>{uSub;}(0, pseqLen<E>(seq), \if(uSub=idx) \then(value) \else(pseqGet<E>(seq,uSub))))
    };

    // --------------------------------------------------------------------
    // rule for seqIndexOf
    // This is logically equivalent to a conditional (partial)
    // definition of  seqIndexOf
    // See also  taclet "seqIndexOf2" below
    // --------------------------------------------------------------------


    pseqIndexOf {
        \schemaVar \term PSeq<E> s;
        \schemaVar \term E t;
        \schemaVar \skolemTerm int jsk;
        \schemaVar \variables int n, m;

        \find(pseqIndexOf<E>(s, t))
        \varcond(
            \notFreeIn(n, s),
            \notFreeIn(n, t),
            \notFreeIn(m, s),
            \notFreeIn(m, t))
        \add((\exists n; (0 <= n & n < pseqLen<E>(s) & pseqGet<E>(s, n) = t))
            ->
            (0 <= pseqIndexOf<E>(s, t) & pseqIndexOf<E>(s, t) < pseqLen<E>(s) &
                pseqGet<E>(s, pseqIndexOf<E>(s, t)) = t &
                \forall m; ((0 <= m & m < pseqIndexOf<E>(s, t)) -> pseqGet<E>(s, m) != t)) ==>)
    };

    // ====================================================================
    //
    //  Derived taclets
    //  All the following taclets can be derived from the taclets occuring prior
    //  to this point in this file.
    //  The taclets differ from the original axiomatization by
    //   (1) the right hand bound in seqDef is now strict
    //   (2) the default value is explicitely given by  pseqGetOutside<E>
    //       instead of   pseqGet<E>(pseqEmpty<E>, 0)
    //
    // ====================================================================

    \lemma
    equalityToPSeqGetAndPSeqLenLeft {
        \schemaVar \term PSeq<E> s, s2;
        \schemaVar \variables int iv;

        \find(s = s2 ==>)
        \varcond(\notFreeIn(iv, s, s2))

        \add(pseqLen<E>(s) = pseqLen<E>(s2)
            & \forall iv; (0 <= iv & iv < pseqLen<E>(s)
                -> pseqGet<E>(s, iv) = pseqGet<E>(s2, iv)) ==>)

        \heuristics(inReachableStateImplication)
        // uncertain about heuristics??
    };

    \lemma
    equalityToPSeqGetAndPSeqLenRight {
        \schemaVar \term PSeq<E> s, s2;
        \schemaVar \variables int iv;

        \find( ==> s = s2)
        \varcond(\notFreeIn(iv, s, s2))

        \replacewith( ==> pseqLen<E>(s) = pseqLen<E>(s2)
            & \forall iv; (0 <= iv & iv < pseqLen<E>(s)
                -> pseqGet<E>(s, iv) = pseqGet<E>(s2, iv)))

        \heuristics(simplify_enlarging)
    };


    \lemma
    pseqSelfDefinition {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \variables PSeq<E> s;
        \schemaVar \variables int u;
        \find(seq)
        \add(\forall s; (s = pseqDef<E>{u;}(0, pseqLen<E>(s), pseqGet<E>(s, u))) ==>)
    };

    \lemma
    pseqOutsideValue {
        \schemaVar \variables PSeq<E> s;
        \schemaVar \variables int iv;
        \find(pseqGetOutside<E>)
        \add(\forall s; (\forall iv; ((iv < 0 | pseqLen<E>(s) <= iv)
                    -> pseqGet<E>(s, iv) = pseqGetOutside<E>)) ==>)
    };

    // --------------------------------------------------------------------
    // derived rule for lenOfX
    // --------------------------------------------------------------------

    \lemma
    lenOfPSeqEmpty {
        \find(pseqLen<E>(pseqEmpty<E>))

        \replacewith(0)

        \heuristics(concrete)
        \generate(\EQ(pseqEmpty<E>))
    };

    \lemma
    lenOfPSeqSingleton {
        \schemaVar \term E x;

        \find(pseqLen<E>(pseqSingleton<E>(x)))

        \replacewith(1)

        \heuristics(concrete)
        \generate(\EQ(pseqSingleton<E>(x)))
    };

    \lemma
    lenOfPSeqConcat {
        \schemaVar \term PSeq<E> seq, seq2;

        \find(pseqLen<E>(pseqConcat<E>(seq, seq2)))

        \replacewith(pseqLen<E>(seq) + pseqLen<E>(seq2))

        \heuristics(simplify)
        \generate(\EQ(pseqConcat<E>(seq, seq2)))
    };

    \lemma
    lenOfPSeqSub {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term int from, to;

        \find(pseqLen<E>(pseqSub<E>(seq, from, to)))

        \replacewith(\if(from < to) \then(to - from) \else(0))

        \heuristics(simplify)
        \generate(\EQ(pseqSub<E>(seq, from, to)))
    };

    \lemma
    lenOfPSeqReverse {
        \schemaVar \term PSeq<E> seq;

        \find(pseqLen<E>(pseqReverse<E>(seq)))

        \replacewith(pseqLen<E>(seq))

        \heuristics(simplify)
        \generate(\EQ(pseqReverse<E>(seq)))
    };

    \lemma
    lenOfPSeqUpd {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term int idx;
        \schemaVar \term E value;

        \find(pseqLen<E>(pseqUpd<E>(seq, idx, value)))
        \replacewith(pseqLen<E>(seq))
        \heuristics(simplify)
    };

    // --------------------------------------------------------------------
    // derived rule for getOfseqX
    // --------------------------------------------------------------------

    \lemma
    getOfPSeqSingleton {
        \schemaVar \term E x;
        \schemaVar \term int idx;

        \find(pseqGet<E>(pseqSingleton<E>(x), idx))

        \replacewith(\if(idx = 0)
                \then(x)
                \else(pseqGetOutside<E>))

        \heuristics(simplify)
        \generate(\EQ(pseqSingleton<E>(x) : no_self_application, simplify_enlarging))
    };

    \lemma
    getOfPSeqSingletonConcrete {
        \schemaVar \term E x;
        \find(pseqGet<E>(pseqSingleton<E>(x), 0))
        \replacewith(x)
        \heuristics(concrete)
    };

    \lemma
    getOfPSeqConcat {
        \schemaVar \term PSeq<E> seq, seq2;
        \schemaVar \term int idx;

        \find(pseqGet<E>(pseqConcat<E>(seq, seq2), idx))

        \replacewith(\if(idx < pseqLen<E>(seq))
                \then(pseqGet<E>(seq, idx))
                \else(pseqGet<E>(seq2, idx - pseqLen<E>(seq))))

        \heuristics(simplify_enlarging)
        \generate(\EQ(pseqConcat<E>(seq, seq2) : no_self_application, simplify_enlarging))
    };

    \lemma
    getOfPSeqSub {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term int idx, from, to;

        \find(pseqGet<E>(pseqSub<E>(seq, from, to), idx))

        \replacewith(\if(0 <= idx & idx < (to - from))
                \then(pseqGet<E>(seq, idx + from))
                \else(pseqGetOutside<E>))

        \heuristics(simplify_enlarging)
        \generate(\EQ(pseqSub<E>(seq, from, to) : no_self_application, simplify_enlarging))
    };

    \lemma
    getOfPSeqReverse {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term int idx;

        \find(pseqGet<E>(pseqReverse<E>(seq), idx))

        \replacewith(pseqGet<E>(seq, pseqLen<E>(seq) - 1 - idx))

        \heuristics(simplify_enlarging)
        \generate(\EQ(pseqReverse<E>(seq) : no_self_application, simplify_enlarging))
    };

    \lemma
    getOfPSeqUpd {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term int idx, jdx;
        \schemaVar \term E value;

        \find(pseqGet<E>(pseqUpd<E>(seq, idx, value), jdx))
        \replacewith(\if(0<=jdx & jdx < pseqLen<E>(seq) & idx=jdx) \then(value) \else(pseqGet<E>(seq, jdx)))
        \heuristics(simplify_enlarging)
    };

    // --------------------------------------------------------------------------
    // derived EQ versions
    // --------------------------------------------------------------------------

    \lemma
    getOfPSeqDefEQ {
        \schemaVar \term int idx, from, to;
        \schemaVar \term PSeq<E> EQ;
        \schemaVar \term E t;
        \schemaVar \variables int uSub, uSub1, uSub2;

        \assumes(pseqDef<E>{uSub;}(from, to, t) = EQ ==>)
        \find(pseqGet<E>(EQ, idx))
        \varcond(\notFreeIn(uSub, from),
            \notFreeIn(uSub, to))
        \replacewith(\if(0 <= idx & idx < (to - from))
                \then({\subst uSub; (idx + from)}t)
                \else(pseqGetOutside<E>))

        \heuristics(simplify_enlarging)
        \displayname "getOfSeqDef"
    };

    \lemma
    lenOfPSeqDefEQ {
        \schemaVar \term int from, to;
        \schemaVar \term PSeq<E> EQ;
        \schemaVar \term E t;
        \schemaVar \variables int uSub, uSub1, uSub2;

        \assumes(pseqDef<E>{uSub;}(from, to, t) = EQ ==>)
        \find(pseqLen<E>(EQ))

        \replacewith(\if(from <= to) \then((to - from)) \else(0))

        \heuristics(simplify)
        \displayname "lenOfSeqDef"
    };

    // --------------------------------------------------------------------------
    // derived taclets involving  pseqEmpty<E>
    // --------------------------------------------------------------------------

    \lemma
    pseqConcatWithPSeqEmpty1 {
        \schemaVar \term PSeq<E> seq;

        \find(pseqConcat<E>(seq, pseqEmpty<E>))

        \replacewith(seq)

        \heuristics(concrete)
        \displayname "seqConcatWithEmpty"
    };

    \lemma
    pseqConcatWithPSeqEmpty2 {
        \schemaVar \term PSeq<E> seq;

        \find(pseqConcat<E>(pseqEmpty<E>, seq))

        \replacewith(seq)

        \heuristics(concrete)
        \displayname "seqConcatWithEmpty"
    };

    \lemma
    pseqReverseOfPSeqEmpty {
        \find(pseqReverse<E>(pseqEmpty<E>))

        \replacewith(pseqEmpty<E>)

        \heuristics(concrete)
    };

    // --------------------------------------------------------------------------
    // derived taclets for special instantiations
    // --------------------------------------------------------------------------

    subPSeqCompletePSeqDef {
        \schemaVar \term int u;
        \schemaVar \term E a;
        \schemaVar \variables int i;

        \find(pseqSub<E>(pseqDef<E>{i;}(0, u, a), 0, u))

        \replacewith(pseqDef<E>{i;}(0, u, a))
        \heuristics(concrete)
        \generate(\EQ(pseqDef<E>{i;}(0, u, a) : no_self_application, concrete))
    };

    \lemma
    subPSeqComplete {
        \schemaVar \term PSeq<E> seq;

        \find(pseqSub<E>(seq, 0, pseqLen<E>(seq)))
        \replacewith(seq)
        \heuristics(concrete)
    };

    subPSeqEmpty {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term int i;
        \find(pseqSub<E>(seq, i, i))
        \replacewith(pseqEmpty<E>)
        \heuristics(concrete)
    };

    \lemma
    subPSeqTailR {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term E x;

        \find(pseqSub<E>(pseqConcat<E>(pseqSingleton<E>(x), seq), 1, pseqLen<E>(seq) + 1))

        \replacewith(seq)

        \heuristics(concrete)
        \displayname "subSeqTail"
        \generate(\EQ(pseqLen<E>(seq)))
    };

    \lemma
    subPSeqTailL {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term E x;

        \find(pseqSub<E>(pseqConcat<E>(pseqSingleton<E>(x), seq), 1, 1 + pseqLen<E>(seq)))

        \replacewith(seq)

        \heuristics(concrete)
        \displayname "subSeqTail"
        \generate(\EQ(pseqLen<E>(seq)))
    };

    subPSeqSingleton {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term E x;

        \find(pseqSub<E>(pseqSingleton<E>(x), 0, 1))

        \replacewith(pseqSingleton<E>(x))

        \heuristics(concrete)
        \generate(\EQ(pseqSingleton<E>(x)))
    };

    subPSeqSingleton2 {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term E x;
        \schemaVar \term int l, u;

        \find(pseqSub<E>(pseqSingleton<E>(x), l, u))

        \replacewith(pseqConcat<E>(pseqSub<E>(pseqEmpty<E>,
                    \if(l < 0) \then(l) \else(0),
                    \if(u < 0) \then(u) \else(0)),
                pseqConcat<E>(\if(l <= 0 & u >= 1)
                        \then(pseqSingleton<E>(x))
                        \else(pseqEmpty<E>),
                    pseqSub<E>(pseqEmpty<E>,
                        \if(l > 0) \then(l) \else(1),
                        \if(u > 0) \then(u) \else(1)))))

        \heuristics(simplify_enlarging)
        \generate(\EQ(pseqSingleton<E>(x) : no_self_application, simplify_enlarging))
    };

    subPSeqConcat {
        \schemaVar \term PSeq<E> s1, s2;
        \schemaVar \term int l, u;

        \find(pseqSub<E>(pseqConcat<E>(s1, s2), l, u))

        \replacewith(pseqConcat<E>(pseqSub<E>(s1, l, \if(pseqLen<E>(s1) < u) \then(pseqLen<E>(s1)) \else(u)),
                pseqSub<E>(s2, \if(l < pseqLen<E>(s1)) \then(0) \else(l - pseqLen<E>(s1)), u - pseqLen<E>(s1))))

        \heuristics(simplify_enlarging)
        \generate(\EQ(pseqConcat<E>(s1, s2) : no_self_application, simplify_enlarging))
    };

    subPSeqHeadPSeqDef {
        \schemaVar \term PSeq<E> seq;
        \schemaVar \term E a;
        \schemaVar \term int u;
        \schemaVar \variables int i;

        \find(pseqSub<E>(pseqConcat<E>(pseqDef<E>{i;}(0, u, a), seq), 0, u))
        \replacewith(pseqDef<E>{i;}(0, u, a))
        \heuristics(concrete)

        \generate(\EQ(pseqDef<E>{i;}(0, u, a)))
    };

    // --------------------------------------------------------------------------
    // other derived taclets
    // --------------------------------------------------------------------------

    \lemma
    pseqDef_split {
        \schemaVar \term int idx, from, to;
        \schemaVar \term E t;
        \schemaVar \variables int uSub, uSub1, uSub2;

        \find(pseqDef<E>{uSub;}(from, to, t))
        \varcond(
            \notFreeIn(uSub1, from),
            \notFreeIn(uSub1, idx),
            \notFreeIn(uSub1, to),
            \notFreeIn(uSub, from),
            \notFreeIn(uSub, idx),
            \notFreeIn(uSub, to),
            \notFreeIn(uSub1, t))
        \replacewith(\if(from <= idx & idx < to)
                \then(pseqConcat<E>(
                        pseqDef<E>{uSub;}(from, idx, t),
                        pseqDef<E>{uSub1;}(idx, to, {\subst uSub; uSub1}t)))
                \else(pseqDef<E>{uSub;}(from, to, t)))
    };

    \lemma
    pseqDef_induction_upper {
        \schemaVar \term int idx, from, to;
        \schemaVar \term E t;
        \schemaVar \variables int uSub, uSub1, uSub2;

        \find(pseqDef<E>{uSub;}(from, to, t))
        \varcond(\notFreeIn(uSub, from),
            \notFreeIn(uSub, to))
        \replacewith(pseqConcat<E>(
                pseqDef<E>{uSub;}(from, to - 1, t),
                \if(from < to) \then(pseqSingleton<E>({\subst uSub; (to - 1)}t))
                    \else(pseqEmpty<E>)))
    };

    \lemma
    pseqDef_induction_upper_concrete {
        \schemaVar \term int idx, from, to;
        \schemaVar \term E t;
        \schemaVar \variables int uSub, uSub1, uSub2;

        \find(pseqDef<E>{uSub;}(from, 1 + to, t))
        \varcond(\notFreeIn(uSub, from),
            \notFreeIn(uSub, to))
        \replacewith(pseqConcat<E>(
                pseqDef<E>{uSub;}(from, to, t),
                \if(from <= to) \then(pseqSingleton<E>({\subst uSub; (to)}t))
                    \else(pseqEmpty<E>)))
        \heuristics(simplify_enlarging)
    };

    \lemma
    pseqDef_induction_lower {
        \schemaVar \term int idx, from, to;
        \schemaVar \term E t;
        \schemaVar \variables int uSub, uSub1, uSub2;

        \find(pseqDef<E>{uSub;}(from, to, t))
        \varcond(\notFreeIn(uSub, from),
            \notFreeIn(uSub, to))
        \replacewith(pseqConcat<E>(
                \if(from < to) \then(pseqSingleton<E>({\subst uSub; (from)}t))
                    \else(pseqEmpty<E>),
                pseqDef<E>{uSub;}(from + 1, to, t)))
    };

    \lemma
    pseqDef_induction_lower_concrete {
        \schemaVar \term int idx, from, to;
        \schemaVar \term E t;
        \schemaVar \variables int uSub, uSub1, uSub2;

        \find(pseqDef<E>{uSub;}(-1 + from, to, t))
        \varcond(\notFreeIn(uSub, from),
            \notFreeIn(uSub, to))
        \replacewith(pseqConcat<E>(
                \if(-1 + from < to) \then(pseqSingleton<E>({\subst uSub; (-1 + from)}t))
                    \else(pseqEmpty<E>),
                pseqDef<E>{uSub;}(from, to, t)))
        \heuristics(simplify)
    };

    \lemma
    pseqDef_split_in_three {
        \schemaVar \term int idx, from, to;
        \schemaVar \term E t;
        \schemaVar \variables int uSub, uSub1, uSub2;

        \find(pseqDef<E>{uSub;}(from, to, t))
        \varcond(
            \notFreeIn(uSub, idx),
            \notFreeIn(uSub1, t),
            \notFreeIn(uSub1, idx),
            \notFreeIn(uSub, from),
            \notFreeIn(uSub1, to))
        "Precondition":
            \add( ==> (from <= idx & idx < to));
        "Splitted SeqDef":
            \replacewith(
                pseqConcat<E>(pseqDef<E>{uSub;}(from, idx, t),
                    pseqConcat<E>(pseqSingleton<E>({\subst uSub; idx}t),
                        pseqDef<E>{uSub1;}(idx + 1, to, {\subst uSub; uSub1}t))))
    };

    \lemma
    pseqDef_empty {
        \schemaVar \term int idx, from, to;
        \schemaVar \term E t;
        \schemaVar \variables int uSub, uSub1, uSub2;

        \find(pseqDef<E>{uSub;}(from, idx, t))
        \varcond(\notFreeIn(uSub, from),
            \notFreeIn(uSub, idx))
        "Precondition":
            \add( ==> idx <= from);
        "Empty SeqDef":
            \replacewith(pseqEmpty<E>)
    };

    \lemma
    pseqDef_one_summand {
        \schemaVar \term int idx, from, to;
        \schemaVar \term E t;
        \schemaVar \variables int uSub, uSub1, uSub2;

        \find(pseqDef<E>{uSub;}(from, idx, t))
        \varcond(\notFreeIn(uSub, from),
            \notFreeIn(uSub, idx))
        \replacewith(\if(from + 1 = idx)
                \then(pseqSingleton<E>({\subst uSub; from}t))
                \else(pseqDef<E>{uSub;}(from, idx, t)))
    };

    \lemma
    pseqDef_lower_equals_upper {
        \schemaVar \term int idx, from, to;
        \schemaVar \term E t;
        \schemaVar \variables int uSub, uSub1, uSub2;

        \find(pseqDef<E>{uSub;}(idx, idx, t))
        \varcond(\notFreeIn(uSub, idx))
        \replacewith(pseqEmpty<E>)
        \heuristics(simplify)
    };

    \lemma // in KeY -- DB 29/10/2013
    pseqDefOfPSeq {
        \schemaVar \term int x;
        \schemaVar \term PSeq<E> s;
        \schemaVar \variables int u, v;
        //    \find(pseqDef<E>{u;}(0,x,pseqGet<E>(s,u)))
        // changed by PHS 17.12.2013
        // original version caused inconsistency
        // proof by DB 29.10.2013 was based on
        // another incorrect taclet that has in the
        // meantime been removed.
        \find(pseqDef<E>{u;}(0, x, pseqGet<E>(s, u)))
        \varcond(\notFreeIn(u, x, s), \notFreeIn(v, x, s))
        \replacewith(\if(pseqLen<E>(s) = x)
                \then(s)
                \else(\if(pseqLen<E>(s) > x)
                        \then(pseqSub<E>(s, 0, x))
                        \else(pseqConcat<E>(s,
                                pseqDef<E>{v;}(pseqLen<E>(s), x, pseqGetOutside<E>))
                        )))
        \heuristics(simplify_enlarging)
    };

    \lemma // in KeY -- DB 29/10/2013
    pseqSelfDefinitionEQ2 {
        \schemaVar \term PSeq<E> s;
        \schemaVar \term int x;
        \schemaVar \variables int u;
        \assumes(pseqLen<E>(s) = x ==>)
        \find(pseqDef<E>{u;}(0, x, pseqGet<E>(s, u)))
        \varcond(\notFreeIn(u, x, s))
        \replacewith(s)
        \heuristics(simplify)
        \displayname "seqSelfDefinition"
    };

    // --------------------------------------------------------------------------
    // derived taclets for seqIndexOf
    // --------------------------------------------------------------------------

    // The following rule has been removed since we agreed
    // to longer support \ifEx.


    //  seqIndexOf2 {
    //  \schemaVar \term PSeq<E> s;
    //  \schemaVar \term E t;
    //  \schemaVar \variables int n;
    //  \find( pseqIndexOf<E>(s,t) )
    //  \varcond ( \notFreeIn(n, s), \notFreeIn(n, t) )
    //  \replacewith( \ifEx n;
    //                (0 <= n & n < pseqLen<E>(s) & pseqGet<E>(s,n)=t)
    //                \then (n)
    //                \else (pseqIndexOf<E>(s,t)) )
    // };

    \lemma
    indexOfPSeqSingleton {
        \schemaVar \term E x;
        \find(pseqIndexOf<E>(pseqSingleton<E>(x), x))
        \replacewith(0)
        \heuristics(concrete)
    };

    \lemma
    indexOfPSeqConcatFirst {
        \schemaVar \term PSeq<E> s1, s2;
        \schemaVar \term E x;
        \schemaVar \variables int idx;
        \find(pseqIndexOf<E>(pseqConcat<E>(s1, s2), x))
        \varcond(\notFreeIn(idx, s1, s2, x))
        \replacewith(pseqIndexOf<E>(s1, x));
        \add( ==> \exists idx; (0 <= idx & idx < pseqLen<E>(s1) &
                pseqGet<E>(s1, idx) = x))
    };

    \lemma
    indexOfPSeqConcatSecond {
        \schemaVar \term PSeq<E> s1, s2;
        \schemaVar \term E x;
        \schemaVar \variables int idx;
        \find(pseqIndexOf<E>(pseqConcat<E>(s1, s2), x))
        \varcond(\notFreeIn(idx, s1, s2, x))
        \replacewith(add(pseqIndexOf<E>(s2, x), pseqLen<E>(s1)));
        \add( ==> (!\exists idx;
                (0 <= idx & idx < pseqLen<E>(s1) & pseqGet<E>(s1, idx) = x)
                & \exists idx;
                (0 <= idx & idx < pseqLen<E>(s2) & pseqGet<E>(s2, idx) = x)))
    };

    \lemma
    indexOfPSeqSub {
        \schemaVar \term PSeq<E> s;
        \schemaVar \term int from, to, n;
        \schemaVar \term E x;
        \schemaVar \variables int nx;

        \find(pseqIndexOf<E>(pseqSub<E>(s, from, to), x))
        \varcond(
            \notFreeIn(nx, s),
            \notFreeIn(nx, x),
            \notFreeIn(nx, from),
            \notFreeIn(nx, to))
        \replacewith(sub(pseqIndexOf<E>(s, x), from));
        \add( ==> from <= pseqIndexOf<E>(s, x) & pseqIndexOf<E>(s, x) < to & 0 <= from &
            \exists nx; ((0 <= nx & nx < pseqLen<E>(s) & pseqGet<E>(s, nx) = x)))
    };
}
