\schemaVariables {
    \term T a, b, e;
    \term Set<T> s, s1, s2, s3, s4, t;
}

\rules {

    // --------------------------------------------------------------------------
    // axioms for elementOf
    // --------------------------------------------------------------------------

    elementOfEmpty {
        \find(elementOf<T>(a, empty<T>))
        \replacewith(false)
        \heuristics(concrete)
    };

    elementOfSingleton {
        \find(elementOf<T>(a, singleton<T>(b)))
        \replacewith(a = b)
        \heuristics(simplify)
    };

    elementOfUnion {
        \find(elementOf<T>(a, union<T>(s, t)))
        \replacewith(elementOf<T>(a, s) | elementOf<T>(a, t))
        \heuristics(simplify_enlarging)
        \generate(\EQ(union<T>(s, t)))
    };

    elementOfIntersect {
        \find(elementOf<T>(a, intersect<T>(s, t)))
        \replacewith(elementOf<T>(a, s) & elementOf<T>(a, t))
        \heuristics(simplify_enlarging)
        \generate(\EQ(intersect<T>(s, t)))
    };

    elementOfSetMinus {
        \find(elementOf<T>(a, setMinus<T>(s, t)))
        \replacewith(elementOf<T>(a, s) & !elementOf<T>(a, t))
        \heuristics(simplify_enlarging)
        \generate(\EQ(setMinus<T>(s, t)))
    };

    elementOfInfiniteUnion {
        // TODO: alpha or any (was like this already in locSetsRules)?
        \schemaVar \variables alpha av;
        \find(elementOf<T>(a, infiniteUnion<T>{av;}(s)))
        \varcond(\notFreeIn(av, a))
        \replacewith(\exists av; elementOf<T>(a, s))
        \heuristics(simplify)
        \generate(\EQ(infiniteUnion<T>{av;}(s)))
    };

    // --------------------------------------------------------------------------
    // axioms for cardinality
    // --------------------------------------------------------------------------
    sCardNonNegative {
        \find(sCard<T>(s))
        \add(sCard<T>(s) >= 0 ==>)
        \heuristics(inReachableStateImplication)
    };

    sCardempty {
        \find(sCard<T>(empty<T>))
        \replacewith(0)
        \heuristics(concrete)
    };

    sCardsingleton {
        \find(sCard<T>(singleton<T>(b)))
        \replacewith(1)
        \heuristics(simplify)
    };

    // --------------------------------------------------------------------------
    // axioms for set predicates (reduce to elementOf)
    // --------------------------------------------------------------------------

    emptyEqualsSingleton {
        \find(empty<T> = singleton<T>(a))
        \replacewith(false)
        \heuristics(concrete)
    };

    singletonEqualsEmpty {
        \find(singleton<T>(a) = empty<T>)
        \replacewith(false)
        \heuristics(concrete)
    };

    unionWithSingletonEqualsUnionWithSingleton {
        \find(union<T>(s, singleton<T>(a)) = union<T>(t, singleton<T>(a)))

        \replacewith(setMinus<T>(s, singleton<T>(a)) = setMinus<T>(t, singleton<T>(a)))
        \heuristics(simplify)
    };

    unionWithSingletonEqualsUnionWithSingleton_2 {
        \find(union<T>(singleton<T>(a), s) = union<T>(singleton<T>(a), t))
        \replacewith(setMinus<T>(s, singleton<T>(a)) = setMinus<T>(t, singleton<T>(a)))
        \heuristics(simplify)
    };

    equalityToElementOf {
        \schemaVar \variables T av;
        \find(s = t)
        \varcond(\notFreeIn(av, s, t))
        \replacewith(\forall av; (elementOf<T>(av, s) <-> elementOf<T>(av, t)))
        \heuristics(semantics_blasting)
        //\heuristics(simplify_enlarging)
    };

    setEqualityToElementOfRight {
        \schemaVar \variables T av;
        \find( ==> s = t)
        \varcond(\notFreeIn(av, s, t))
        \replacewith( ==> \forall av; (elementOf<T>(av, s) <-> elementOf<T>(av, t)))
        \heuristics(setEqualityBlastingRight)
    }

    subsetToElementOf {
        \schemaVar \variables T av;
        \find(subset<T>(s, t))
        \varcond(\notFreeIn(av, s, t))
        \replacewith(\forall av; (elementOf<T>(av, s) -> elementOf<T>(av, t)))
        \heuristics(semantics_blasting)
        //\heuristics(simplify_enlarging)
    };

    \lemma
    subsetToElementOfRight {
        \schemaVar \variables T av;
        \find( ==> subset<T>(s, t))
        \varcond(\notFreeIn(av, s, t))
        \replacewith( ==> \forall av; (elementOf<T>(av, s) -> elementOf<T>(av, t)))
        \heuristics(setEqualityBlastingRight)
    }

    disjointToElementOf {
        \schemaVar \variables T av;
        \find(disjoint<T>(s, t))
        \varcond(\notFreeIn(av, s, t))
        \replacewith(\forall av; (!elementOf<T>(av, s) | !elementOf<T>(av, t)))
        \heuristics(semantics_blasting)
    };

    // proven with KeY (CS)
    elementOfSubsetImpliesElementOfSuperset {
        \assumes(subset<T>(s, s2) ==>)

        \find(elementOf<T>(e, s) ==>)

        \add(elementOf<T>(e, s2) ==>)

        \heuristics(simplify_enlarging)
    };

    // proven with KeY (CS)
    noElementOfSupersetImpliesNoElementOfSubset {
        \assumes(subset<T>(s, s2) ==>)
        \find( ==> elementOf<T>(e, s2))
        \add( ==> elementOf<T>(e, s))

        \heuristics(simplify_enlarging)
    };

    // proven with KeY (CS)
    subsetSingletonLeft {
        \find(subset<T>(singleton<T>(e), s))

        \replacewith(elementOf<T>(e, s))

        \heuristics(simplify)
        // proven with KeY (CS)
        \generate(\EQ(singleton<T>(e)))
    };

    // proven with KeY (CS)
    subsetSingletonRight {
        \find(subset<T>(s, singleton<T>(e)))

        \replacewith(s = empty<T> | s = singleton<T>(e))

        \heuristics(simplify)
        // proven with KeY (CS)
        \generate(\EQ(singleton<T>(e)))
    };

    // proven with KeY (CS)
    subsetUnionLeft {
        \find(subset<T>(union<T>(s, s2), s3))

        \replacewith(subset<T>(s, s3) & subset<T>(s2, s3))

        \heuristics(simplify_enlarging)
        // proven with KeY (CS)
        \generate(\EQ(union<T>(s, s2)))
    };

    // proven with KeY (CS)
    subsetOfUnionWithItSelf1 {
        \find(subset<T>(s, union<T>(s, s2)))

        \replacewith(true)

        \heuristics(concrete)
        // proven with KeY (CS)
        \generate(\EQ(union<T>(s, s2)))
    };

    // proven with KeY (CS)
    subsetOfUnionWithItSelf2 {
        \find(subset<T>(s, union<T>(s2, s)))

        \replacewith(true)

        \heuristics(concrete)
        // proven with KeY (CS)
        \generate(\EQ(union<T>(s2, s)))
    };


    // proven with KeY (CS)
    subsetOfIntersectWithItSelf1 {
        \find(subset<T>(s, intersect<T>(s, s2)))

        \replacewith(subset<T>(s, s2))

        \heuristics(concrete)
        // proven with KeY (CS)
        \generate(\EQ(intersect<T>(s, s2)))
    };

    // proven with KeY (CS)
    subsetOfIntersectWithItSelf2 {
        \find(subset<T>(s, intersect<T>(s2, s)))

        \replacewith(subset<T>(s, s2))

        \heuristics(concrete)
        \generate(\EQ(intersect<T>(s2, s)))
    };

    // proven with KeY (CS)
    elementOfSubsetOfUnion1 {
        \assumes(subset<T>(s, union<T>(s2, s3)),
            ==> elementOf<T>(e, s2))
        \find(elementOf<T>(e, s))

        \add(elementOf<T>(e, s) <-> elementOf<T>(e, intersect<T>(s, s3)) ==>)

        \heuristics(simplify_enlarging)
    };

    // proven with KeY (CS)
    elementOfSubsetOfUnion2 {
        \assumes(subset<T>(s, union<T>(s2, s3)),
            ==> elementOf<T>(e, s3))
        \find(elementOf<T>(e, s))

        \add(elementOf<T>(e, s) <-> elementOf<T>(e, intersect<T>(s, s2)) ==>)

        \heuristics(simplify_enlarging)
    };

    // proven with KeY (CS)
    disjointDefinition {
        \find(disjoint<T>(s, s2))

        \replacewith(intersect<T>(s, s2) = empty<T>)
        // \heuristics(semantics_blasting)
        \heuristics(simplify)
    };

    // proven with KeY (CS)
    disjointNotInOtherSet1 {
        \assumes(intersect<T>(s, s2) = empty<T> ==>)
        \find(elementOf<T>(e, s) ==>)

        \add( ==> elementOf<T>(e, s2))

        \heuristics(simplify_enlarging)
    };

    // proven with KeY (CS)
    disjointNotInOtherSet2 {
        \assumes(intersect<T>(s, s2) = empty<T> ==>)
        \find(elementOf<T>(e, s2) ==>)

        \add( ==> elementOf<T>(e, s))

        \heuristics(simplify_enlarging)
    };

    // proven with KeY (CS)
    disjointAndSubset1 {
        \assumes(intersect<T>(s2, s3) = empty<T> ==>)
        \find(subset<T>(s, s2) ==>)

        \add(intersect<T>(s, s3) = empty<T> ==>)

        \heuristics(simplify_enlarging)
    };

    // proven with KeY (CS)
    disjointAndSubset2 {
        \assumes(intersect<T>(s2, s3) = empty<T> ==>)
        \find(subset<T>(s, s3) ==>)

        \add(intersect<T>(s, s2) = empty<T> ==>)

        \heuristics(simplify_enlarging)
    };

    // proven with KeY (CS)
    disjointInfiniteUnion {
        \schemaVar \variables int iv;

        \find(intersect<T>(infiniteUnion<T>{iv;}(s2), s) = empty<T>)
        \varcond(\notFreeIn(iv, s))

        \replacewith(\forall iv; (intersect<T>(s2, s) = empty<T>))

        \heuristics(simplify)
    };

    // proven with KeY (CS)
    disjointInfiniteUnion_2 {
        \schemaVar \variables int iv;

        \find(intersect<T>(s, infiniteUnion<T>{iv;}(s2)) = empty<T>)
        \varcond(\notFreeIn(iv, s))

        \replacewith(\forall iv; (intersect<T>(s, s2) = empty<T>))

        \heuristics(simplify)
    };

    // proven with KeY (CS)
    disjointAndSubset_3 {
        \assumes(intersect<T>(s1, s2) = empty<T> ==>)
        \find(subset<T>(s4, union<T>(s2, s3)) ==>)
        \add(intersect<T>(s1, s3) = empty<T> -> intersect<T>(s1, s4) = empty<T> ==>)
        \heuristics(simplify_enlarging)
    };

    // proven with KeY (CS)
    disjointAndSubset_4 {
        \assumes(intersect<T>(s1, s2) = empty<T> ==>)
        \find(subset<T>(s4, union<T>(s3, s2)) ==>)
        \add(intersect<T>(s1, s3) = empty<T> -> intersect<T>(s1, s4) = empty<T> ==>)
        \heuristics(simplify_enlarging)
    };

    // proven with KeY (CS)
    disjointAndSubset_5 {
        \assumes(intersect<T>(s2, s1) = empty<T> ==>)
        \find(subset<T>(s4, union<T>(s2, s3)) ==>)
        \add(intersect<T>(s1, s3) = empty<T> -> intersect<T>(s1, s4) = empty<T> ==>)
        \heuristics(simplify_enlarging)
    };

    // proven with KeY (CS)
    disjointAndSubset_6 {
        \assumes(intersect<T>(s2, s1) = empty<T> ==>)
        \find(subset<T>(s4, union<T>(s3, s2)) ==>)
        \add(intersect<T>(s1, s3) = empty<T> -> intersect<T>(s1, s4) = empty<T> ==>)
        \heuristics(simplify_enlarging)
    };

    // --------------------------------------------------------------------------
    // equality rules
    // --------------------------------------------------------------------------

    // Proven in KeY (DD: 2025-02-20)
    \lemma
    equalityOfSingleton {
        \schemaVar \term T e1, e2;

        \find(singleton<T>(e1) = singleton<T>(e2))

        \replacewith(e1 = e2)

        \heuristics(simplify)
    };

    // --------------------------------------------------------------------------
    // lemmas for empty
    // --------------------------------------------------------------------------

    unionWithEmpty {
        \find(union<T>(empty<T>, s))

        \replacewith(s)

        \heuristics(concrete)
    };

    intersectWithEmpty {
        \find(intersect<T>(empty<T>, s))

        \replacewith(empty<T>)

        \heuristics(concrete)
    };

    // the following set of rules should be the only one needed
    // for empty elimination as the strategies take care to commute the
    // the empty set always on the second place
    // the other rules are left for backward proof loading compatibility
    // begin
    unionWithEmptyRight {
        \find(union<T>(s, empty<T>))

        \replacewith(s)

        \displayname "unionWithEmpty"
        \heuristics(concrete)
    };

    intersectWithEmptyRight {
        \find(intersect<T>(s, empty<T>))

        \replacewith(empty<T>)

        \displayname "intersectWithEmpty"
        \heuristics(concrete)
    };

    setMinusWithEmpty1 {
        \find(setMinus<T>(s, empty<T>))

        \replacewith(s)

        \displayname "setMinusWithEmpty"
        \heuristics(concrete)
    };

    setMinusWithEmpty2 {
        \find(setMinus<T>(empty<T>, s))

        \replacewith(empty<T>)

        \displayname "setMinusWithEmpty"
        \heuristics(concrete)
    };

    // --------------------------------------------------------------------------
    // lemmas for subset
    // --------------------------------------------------------------------------

    subsetWithEmpty {
        \find(subset<T>(empty<T>, s))

        \replacewith(true)

        \heuristics(concrete)
    };

    subsetOfEmpty {
        \find(subset<T>(s, empty<T>))

        \replacewith(s = empty<T>)

        \heuristics(concrete)
    };

    // --------------------------------------------------------------------------
    // lemmas for disjoint
    // --------------------------------------------------------------------------

    disjointWithEmpty {
        \find(disjoint<T>(empty<T>, s))

        \replacewith(true)

        \heuristics(concrete)
    };

    \lemma
    disjointWithSingleton1 {
        \find(intersect<T>(s, singleton<T>(e)) = empty<T>)
        \replacewith(!elementOf<T>(e, s))
        \heuristics(simplify)
        \displayname "disjointWithSingleton"
    };

    \lemma
    disjointWithSingleton2 {
        \find(intersect<T>(singleton<T>(e), s) = empty<T>)
        \replacewith(!elementOf<T>(e, s))
        \heuristics(simplify)
        \displayname "disjointWithSingleton"
    };

    // --------------------------------------------------------------------------
    // some other lemmas
    // --------------------------------------------------------------------------

    // proven with KeY (CS)
    unionEqualsEmpty {
        \find(union<T>(s, s2) = empty<T>)

        \replacewith(s = empty<T> & s2 = empty<T>)

        \heuristics(simplify_enlarging)
        // proven with KeY (CS)
        \generate(\EQ(union<T>(s, s2)))
    };

    \lemma
    intersectUnionEqualsEmpty {
        \find(intersect<T>(union<T>(s, s2), t) = empty<T>)

        \replacewith(intersect<T>(s, t) = empty<T> & intersect<T>(s2, t) = empty<T>)

        \heuristics(simplify_enlarging)
        \generate(\EQ(union<T>(s, s2)))
    }

    \lemma
    intersectUnionEqualsEmpty2 {
        \find(intersect<T>(t, union<T>(s, s2)) = empty<T>)

        \replacewith(intersect<T>(t, s) = empty<T> & intersect<T>(t, s2) = empty<T>)

        \heuristics(simplify_enlarging)
        \generate(\EQ(union<T>(s, s2)))
    }

    // proven with KeY (CS)
    setMinusOfUnion {
        \schemaVar \term Set<T> distributedSet, unionLeft, unionRight;

        \find(setMinus<T>(union<T>(unionLeft, unionRight), distributedSet))

        \replacewith(union<T>(setMinus<T>(unionLeft, distributedSet),
                setMinus<T>(unionRight, distributedSet)))

        \heuristics(setDist)
        // proven with KeY (CS)
        \generate(\EQ(union<T>(unionLeft, unionRight)))
    };

    // proven with KeY (CS)
    subsetWithSetMinusLeft {
        \find(subset<T>(setMinus<T>(s, s2), s3))

        \replacewith(subset<T>(s, union<T>(s2, s3)))

        \heuristics(simplify_enlarging)
        // proven with KeY (CS)
        \generate(\EQ(setMinus<T>(s, s2)))
    };

    unionWithItself {
        \find(union<T>(s, s))

        \replacewith(s)

        \heuristics(concrete)
    };

    intersectWithItself {
        \find(intersect<T>(s, s))

        \replacewith(s)

        \heuristics(concrete)
    };

    distributeIntersection {
        \schemaVar \term Set<T> distributedSet, unionLeft, unionRight;

        \find(intersect<T>(distributedSet, union<T>(unionLeft, unionRight)))

        \replacewith(union<T>(intersect<T>(distributedSet, unionLeft),
                intersect<T>(distributedSet, unionRight)))

        \heuristics(setDist)
        \generate(\EQ(union<T>(unionLeft, unionRight)))
    };

    distributeIntersection2 {
        \schemaVar \term Set<T> distributedSet, unionLeft, unionRight;

        \find(intersect<T>(union<T>(unionLeft, unionRight), distributedSet))

        \replacewith(union<T>(intersect<T>(unionLeft, distributedSet),
                intersect<T>(unionRight, distributedSet)))

        \heuristics(setDist)
        \generate(\EQ(union<T>(unionLeft, unionRight)))
    };

    intersectWithSingleton {
        \find(intersect<T>(singleton<T>(e), s))

        \replacewith(\if(elementOf<T>(e, s)) \then(singleton<T>(e)) \else(empty<T>))

        \heuristics(simplify_enlarging)
    };

    setMinusItself {
        \find(setMinus<T>(s, s))

        \replacewith(empty<T>)

        \heuristics(concrete)
    };

    setMinusSingleton {
        \assumes( ==> elementOf<T>(e, s))

        \find(setMinus<T>(s, singleton<T>(e)))

        \replacewith(s)

        \heuristics(simplify)
    };

    setMinusWithSingleton {
        \find(setMinus<T>(singleton<T>(e), s))

        \replacewith(\if(elementOf<T>(e, s)) \then(empty<T>) \else(singleton<T>(e)))

        \heuristics(simplify_enlarging)
    }

    intersectionSetMinusItself {
        \find(intersect<T>(setMinus<T>(s1, s2), s2))

        \replacewith(empty<T>)

        \heuristics(concrete)
    };

    intersectionSetMinusItself_2 {
        \find(intersect<T>(s2, setMinus<T>(s1, s2)))

        \replacewith(empty<T>)

        \heuristics(concrete)
    };

    unionIntersectItself {
        \find(union<T>(intersect<T>(s1, s2), s1))

        \replacewith(s1)

        \heuristics(simplify)
    };

    unionIntersectItself_2 {
        \find(union<T>(intersect<T>(s2, s1), s1))

        \replacewith(s1)

        \heuristics(simplify)
    };

    unionIntersectItself_3 {
        \find(union<T>(union<T>(s, intersect<T>(s1, s2)), s1))

        \replacewith(union<T>(s, s1))

        \heuristics(simplify)
    };

    unionIntersectItself_4 {
        \find(union<T>(union<T>(s, intersect<T>(s2, s1)), s1))

        \replacewith(union<T>(s, s1))

        \heuristics(simplify)
    };

    \lemma
    unionIntersectItself5 {
        \find(union<T>(s1, intersect<T>(s1, s2)))

        \replacewith(s1)

        \heuristics(simplify)
        \generate(\EQ(intersect<T>(s1, s2)))
        \displayname "unionIntersectItself"
    }

    \lemma
    unionIntersectItself6 {
        \find(union<T>(s1, intersect<T>(s2, s1)))

        \replacewith(s1)

        \heuristics(simplify)
        \generate(\EQ(intersect<T>(s2, s1)))
        \displayname "unionIntersectItself"
    }

    \lemma
    intersectUnionItself {
        \find(intersect<T>(union<T>(s1, s2), s1))

        \replacewith(s1)

        \heuristics(simplify)
        \generate(\EQ(union<T>(s1, s2)))
        \displayname "intersectUnionItself"
    }

    \lemma
    intersectUnionItself2 {
        \find(intersect<T>(union<T>(s2, s1), s1))

        \replacewith(s1)

        \heuristics(simplify)
        \generate(\EQ(union<T>(s2, s1)))
        \displayname "intersectUnionItself"
    }

    \lemma
    intersectUnionItself3 {
        \find(intersect<T>(s1, union<T>(s1, s2)))

        \replacewith(s1)

        \heuristics(simplify)
        \generate(\EQ(union<T>(s1, s2)))
        \displayname "intersectUnionItself"
    }

    \lemma
    intersectUnionItself4 {
        \find(intersect<T>(s1, union<T>(s2, s1)))

        \replacewith(s1)

        \heuristics(simplify)
        \generate(\EQ(union<T>(s2, s1)))
        \displayname "intersectUnionItself"
    }

    \lemma
    subsetIntersectLeft {
        \find(subset<T>(intersect<T>(s1, s2), s1))

        \replacewith(true)

        \heuristics(concrete)
        \generate(\EQ(intersect<T>(s1, s2)))
        \displayname "subsetIntersectLeft"
    }

    \lemma
    subsetIntersectLeft2 {
        \find(subset<T>(intersect<T>(s2, s1), s1))

        \replacewith(true)

        \heuristics(concrete)
        \generate(\EQ(intersect<T>(s2, s1)))
        \displayname "subsetIntersectLeft"
    }

    \lemma
    unionSetMinusItself {
        \find(union<T>(setMinus<T>(s1, s2), s2))

        \replacewith(union<T>(s1, s2))

        \heuristics(simplify)
        \generate(\EQ(setMinus<T>(s1, s2)))
        \displayname "unionSetMinusItself"
    }

    \lemma
    unionSetMinusItself2 {
        \find(union<T>(s2, setMinus<T>(s1, s2)))

        \replacewith(union<T>(s2, s1))

        \heuristics(simplify)
        \generate(\EQ(setMinus<T>(s1, s2)))
        \displayname "unionSetMinusItself"
    }

    \lemma
    setMinusEqualsEmpty {
        \find(setMinus<T>(s1, s2) = empty<T>)

        \replacewith(subset<T>(s1, s2))

        \heuristics(simplify)
        \generate(\EQ(setMinus<T>(s1, s2)))
    }

    unionIntersectItself_5 {
        \find(union<T>(union<T>(intersect<T>(s1, s2), s), s1))

        \replacewith(union<T>(s, s1))

        \heuristics(simplify)
    };

    unionIntersectItself_6 {
        \find(union<T>(union<T>(intersect<T>(s2, s1), s), s1))

        \replacewith(union<T>(s, s1))

        \heuristics(simplify)
    };

    infiniteUnionUnused {
        \schemaVar \variables alpha av;
        \find(infiniteUnion<T>{av;}(s))
        \varcond(\notFreeIn(av, s))

        \replacewith(s)

        \heuristics(concrete)
    };

    subsetOfItself {
        \find(subset<T>(s, s))

        \replacewith(true)

        \heuristics(concrete)
    };

    // really needed for efficiency?
    elementOfGuardedSet {
        \schemaVar \formula phi;

        \find(elementOf<T>(e, \if(phi) \then(s) \else(empty<T>)))

        \replacewith(phi & elementOf<T>(e, s))

        \heuristics(concrete)
    };

    commuteDisjoint {
        \schemaVar \term Set<T> commLeft, commRight;

        \find(disjoint<T>(commLeft, commRight))
        \replacewith(disjoint<T>(commRight, commLeft))

        \heuristics(setComm)
    };

    commuteUnion {
        \schemaVar \term Set<T> commLeft, commRight;

        \find(union<T>(commLeft, commRight))

        \replacewith(union<T>(commRight, commLeft))

        \heuristics(setComm)
    };

    commuteUnion_2 {
        \schemaVar \term Set<T> commLeft, commRight;

        \find(union<T>(union<T>(s, commLeft), commRight))

        \replacewith(union<T>(union<T>(s, commRight), commLeft))

        \heuristics(setComm)
    };

    commuteIntersection {
        \schemaVar \term Set<T> commLeft, commRight;

        \find(intersect<T>(commLeft, commRight))

        \replacewith(intersect<T>(commRight, commLeft))

        \heuristics(setComm)
    };

    commuteIntersection_2 {
        \schemaVar \term Set<T> commLeft, commRight;

        \find(intersect<T>(intersect<T>(s, commLeft), commRight))

        \replacewith(intersect<T>(intersect<T>(s, commRight), commLeft))

        \heuristics(setComm)
    };

    associativeLawUnion {
        \find(union<T>(s1, union<T>(s2, s3)))

        \replacewith(union<T>(union<T>(s1, s2), s3))

        \heuristics(setAssoc)
    };

    associativeLawIntersect {
        \find(intersect<T>(s1, intersect<T>(s2, s3)))

        \replacewith(intersect<T>(intersect<T>(s1, s2), s3))

        \heuristics(setAssoc)
    };
}
