/*!
Abstract datatype of (typed) partial maps.

* Author: **Daniel Bruns**, **Daniel Drodt**
* Documentation added by **Alexander Weigl** <weigl@kit.edu>
*/

\sorts {
    \generic K;
    \generic V;
    PMap<K, V>;
}

\functions {
    /*! Return a value from the given PMap.  If value is undefined, `pmapUndef` is used. */
    V pmapGet<K, V>(PMap<K, V>, K);

    /*! A unique value, which is returned by pmapGet in case no mapping value is declared for the specified key. */
    \unique V pmapUndef<V>;

    // constructors
    /*! Generalized quantifier for parametric maps. This is a generic constructor for parametric maps. */
    PMap<K, V> pmapForeach<K, V> {true, true}(boolean, V);

    /*! The empty map, which does not contain any entries. */
    PMap<K, V> pmapEmpty<K, V>;

    /*! A map, which contains only one entry. */
    PMap<K, V> pmapSingleton<K, V>(K, V);

    /*! Takes as arguments two maps and creates a new map from their entries. In case their domains overlap,
        entries of the second map are used for keys from the intersection. */
    PMap<K, V> pmapOverride<K, V>(PMap<K, V>, PMap<K, V>);

    /*! Converts a sequence to a map. The map domain consists of exactly those integers, which are inside the sequence bounds. */
    PMap<int, V> pseq2pmap<V>(PSeq<V>);

    /*! Adds an entry to a map or overwrites an existing one. */
    PMap<K, V> pmapUpdate<K, V>(PMap<K, V>, K, V);

    /*! Removes an entry from a map. */
    PMap<K, V> pmapRemove<K, V>(PMap<K, V>, K);
}

\predicates {
    /*! Takes two arguments: key &#8712; K and map &#8712; PMap<K, V>. Returns true iff key is in the domain of map. */
    pmapInDomain<K, V>(PMap<K, V>, K);

    /*! Returns true iff the domain of the specified map contains only objects that are <created>;
        in the implicit heap (additional non-object values may also be part of the domain). This can be used
        in a JML specification as an invariant to ensure, that non-created objects are not (yet) part
        of the domain of a map. */
    pmapInDomainImpliesCreated<K, V>(PMap<K, V>);
}
