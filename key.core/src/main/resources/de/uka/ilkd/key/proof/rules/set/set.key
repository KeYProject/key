\sorts {
    \generic T;
    Set<T>;
}

\functions {
    /*! The empty set which does not contain any elements. */
    \unique Set<T> empty<T>;

    // other constructors
    /*! Converts a single element to a set with one element. */
    Set<T> singleton<T>(T);
     /*! Union between two sets. */
    Set<T> union<T>(Set<T>, Set<T>);
    /*! Intersection between two sets. */
    Set<T> intersect<T>(Set<T>, Set<T>);
    /*! Realizes relative complement (a.k.a. set difference) between two sets. It takes as arguments
        two sets and returns another set which contains all elements from the first argument
        except those that are elements of the second argument. */
    Set<T> setMinus<T>(Set<T>, Set<T>);
    /*! Takes as argument a term of type Set, which may contain a free variable. The term represents a family
        of sets, which is parameterized by the unbound variable. The returned set is the union
        over all members of the parameterized family. */
    Set<T> infiniteUnion<T>{true}(Set<T>);

    int sCard<T>(Set<T>);
}

\predicates {
    /*! This is the set theoretic membership predicate to be used for sets.

        It takes two arguments: The first is the element and the
        second is the set against which membership is tested. */
    elementOf<T>(T, Set<T>);
    /*! This is the set theoretic subset predicate to be used for sets.

        A set A is subset of another set B iff every element of A is also element of B.*/
    subset<T>(Set<T>, Set<T>);
    /*! This binary predicate models disjointness of sets.

        disjoint(A,B) is true iff A and B have an empty intersection,
        it is thus equivalent to intersect(A,B) = empty.*/
    disjoint<T>(Set<T>, Set<T>);
}
