\schemaVariables {
    \term PMap<K, V> m, m0, m1;
    \term K key, key1;
    \term V value;
    \term boolean b;
    \variables K kv;
    \variables V vv;
}

\rules {
    // --------------------------------------------------------------------------
    // axioms
    // --------------------------------------------------------------------------

    // Added by Kai Wallisch
    defPMapEquality {
        \find(m0 = m1)
        \varcond(\notFreeIn(kv, m0, m1))
        \replacewith(\forall kv; ((pmapInDomain<K, V>(m0, kv) <-> pmapInDomain<K, V>(m1, kv)) &
                (pmapInDomain<K, V>(m0, kv) -> pmapGet<K, V>(m0, kv) = pmapGet<K, V>(m1, kv))))
    };

    inDomainOfPMapForeach {
        \find(pmapInDomain<K, V>(pmapForeach<K, V>{kv;}(b, value), key))
        \replacewith({\subst kv; key}b = TRUE)
        \heuristics(simplify)
    };

    getOfPMapForeach {
        \find(pmapGet<K, V>(pmapForeach<K, V>{kv;}(b, value), key))
        \replacewith(\if(pmapInDomain<K, V>(pmapForeach<K, V>{kv;}(b, value), key))
                \then({\subst kv; key}value)
                \else(pmapUndef<V>))
        \heuristics(simplify_enlarging)
    };

    // --------------------------------------------------------------------------
    // definitions (conservative extensions)
    // --------------------------------------------------------------------------

    defPMapEmpty {
        \find(pmapEmpty<K, V>)
        \replacewith(pmapForeach<K, V>{kv;}(FALSE, pmapUndef<V>))
    };

    defPMapSingleton {
        \find(pmapSingleton<K, V>(key, value))
        \varcond(\notFreeIn(kv, key, value))
        \replacewith(pmapForeach<K, V>{kv;}(
                \if(kv = key) \then(TRUE) \else(FALSE), value)
        )
    };

    defPMapOverride {
        \find(pmapOverride<K, V>(m0, m1))
        \varcond(\notFreeIn(kv, m0, m1))
        \replacewith(pmapForeach<K, V>{kv;}(
                \if(pmapInDomain<K, V>(m0, kv) | pmapInDomain<K, V>(m1, kv)) \then(TRUE) \else(FALSE),
                \if(pmapInDomain<K, V>(m1, kv))
                    \then(pmapGet<K, V>(m1, kv)) \else(pmapGet<K, V>(m0, kv))
            ))
    };

    defPSeq2PMap {
        \schemaVar \term PSeq<V> s;
        \schemaVar \variables int ix;
        \find(pseq2pmap<V>(s))
        \varcond(\notFreeIn(ix, s))
        \replacewith(pmapForeach<int, V>{ix;}(
                \if(0 <= ix & ix < pseqLen<V>(s)) \then(TRUE) \else(FALSE),
                pseqGet<V>(s, ix)
            ))
    };

    // Added by Kai Wallisch
    defPMapUpdate {
        \find(pmapUpdate<K, V>(m, key, value))
        \varcond(\notFreeIn(kv, m, key, value))
        \replacewith(pmapForeach<K, V>{kv;}(
                \if(pmapInDomain<K, V>(m, kv) | kv = key)
                    \then(TRUE)
                    \else(FALSE),
                \if(kv = key)
                    \then(value)
                    \else(pmapGet<K, V>(m, kv))
            ))
    };

    // Added by Kai Wallisch
    defPMapRemove {
        \find(pmapRemove<K, V>(m, key))
        \varcond(\notFreeIn(kv, m, key))
        \replacewith(pmapForeach<K, V>{kv;}(
                \if(pmapInDomain<K, V>(m, kv) & kv != key)
                    \then(TRUE)
                    \else(FALSE),
                pmapGet<K, V>(m, kv)
            ))
    };

    // Added by Kai Wallisch
    defPMapInDomainImpliesCreated {
        \schemaVar \term PMap<Object, V> om;
        \schemaVar \variables Object o;
        \find(pmapInDomainImpliesCreated<Object, V>(om))
        \varcond(\notFreeIn(o, om))
        \replacewith(\forall o; (pmapInDomain<Object, V>(om, o) ->
                select<boolean>(heap, o, java.lang.Object::#$created) = TRUE))
        \heuristics(simplify_enlarging)
    };

    // --------------------------------------------------------------------------
    // derived map equality rules (proven sound in KeY)
    // --------------------------------------------------------------------------

    // Added by Kai Wallisch
    \lemma
    pmapEqualityRight {
        \find( ==> m0 = m1)
        \varcond(\notFreeIn(kv, m0, m1))
        \replacewith( ==> \forall kv; ((pmapInDomain<K, V>(m0, kv) <-> pmapInDomain<K, V>(m1, kv)) &
                (pmapInDomain<K, V>(m0, kv) -> pmapGet<K, V>(m0, kv) = pmapGet<K, V>(m1, kv))))
        \heuristics(simplify_enlarging)
    };

    // Added by Kai Wallisch
    \lemma
    pmapUpdateUnchanged {
        \find(m = pmapUpdate<K, V>(m, key, value))
        \replacewith(pmapInDomain<K, V>(m, key) & pmapGet<K, V>(m, key) = value)
        \heuristics(simplify_enlarging)
    };

    // Added by Kai Wallisch
    \lemma
    pmapUpdateUnchanged2 {
        \find(pmapUpdate<K, V>(m, key, value) = m)
        \replacewith(pmapInDomain<K, V>(m, key) & pmapGet<K, V>(m, key) = value)
        \heuristics(simplify_enlarging)
    };

    // Added by Kai Wallisch
    \lemma
    pmapRemoveUnchanged {
        \find(m = pmapRemove<K, V>(m, key))
        \replacewith(!pmapInDomain<K, V>(m, key))
        \heuristics(simplify_enlarging)
    };

    // Added by Kai Wallisch
    \lemma
    pmapRemoveUnchanged2 {
        \find(pmapRemove<K, V>(m, key) = m)
        \replacewith(!pmapInDomain<K, V>(m, key))
        \heuristics(simplify_enlarging)
    };

    // --------------------------------------------------------------------------
    // derived inDomain rules (proven sound in KeY)
    // --------------------------------------------------------------------------
    \lemma
    inDomainOfPMapEmpty {
        \find(pmapInDomain<K, V>(pmapEmpty<K, V>, key))
        \replacewith(false)
        \heuristics(concrete)
    };

    \lemma
    inDomainOfPMapSingleton {
        \find(pmapInDomain<K, V>(pmapSingleton<K, V>(key, value), key1))
        \replacewith(key = key1)
        \heuristics(simplify)
    };

    \lemma
    inDomainOfPMapOverride {
        \find(pmapInDomain<K, V>(pmapOverride<K, V>(m0, m1), key))
        \replacewith(pmapInDomain<K, V>(m0, key) | pmapInDomain<K, V>(m1, key))
        \heuristics(simplify)
    };

    \lemma
    inDomainOfPSeq2PMap {
        \schemaVar \term PSeq<V> s;
        \schemaVar \term int ki;
        \find(pmapInDomain<int, V>(pseq2pmap<V>(s), ki))
        \replacewith(0 <= ki & ki < pseqLen<V>(s))
        \heuristics(simplify)
    };

    // Added by Kai Wallisch
    \lemma
    inDomainOfPMapUpdate {
        \find(pmapInDomain<K, V>(pmapUpdate<K, V>(m, key, value), key1))
        \replacewith(pmapInDomain<K, V>(m, key1) | (key1 = key))
        \heuristics(simplify_enlarging)
    };

    // Added by Kai Wallisch
    \lemma
    inDomainOfPMapRemove {
        \find(pmapInDomain<K, V>(pmapRemove<K, V>(m, key), key1))
        \replacewith(pmapInDomain<K, V>(m, key1) & (key1 != key))
        \heuristics(simplify_enlarging)
    };

    // Added by Kai Wallisch
    pmapNotInDomain {
        \find( ==> pmapInDomain<K, V>(m, key))
        \add(pmapGet<K, V>(m, key) = pmapUndef<V> ==>)
        \heuristics(inReachableStateImplication)
    };

    \lemma
    pmapInDomainConcrete {
        \assumes( ==> pmapUndef<V> = value)
        \find(pmapGet<K, V>(m, key) = value ==>)
        \add(pmapInDomain<K, V>(m, key) ==>)
        \heuristics(inReachableStateImplication)
    };

    // --------------------------------------------------------------------------
    // derived pmapGet rules (proven sound in KeY)
    // --------------------------------------------------------------------------

    // Added by Kai Wallisch
    \lemma
    getOfPMapEmpty {
        \find(pmapGet<K, V>(pmapEmpty<K, V>, key))
        \replacewith(pmapUndef<V>)
        \heuristics(simplify)
    };

    \lemma
    getOfPMapSingleton {
        \find(pmapGet<K, V>(pmapSingleton<K, V>(key, value), key1))
        \replacewith(\if(key = key1) \then(value) \else(pmapUndef<V>))
        \heuristics(simplify)
    };

    \lemma
    getOfPMapOverride {
        \find(pmapGet<K, V>(pmapOverride<K, V>(m0, m1), key))
        \replacewith(\if(pmapInDomain<K, V>(m1, key))
                \then(pmapGet<K, V>(m1, key)) \else(pmapGet<K, V>(m0, key)))
        \heuristics(simplify_enlarging)
    };

    \lemma
    getOfPSeq2PMap {
        \schemaVar \term PSeq<V> s;
        \schemaVar \term int ki;
        \find(pmapGet<int, V>(pseq2pmap<V>(s), ki))
        \replacewith(\if(0 <= ki & ki < pseqLen<V>(s))
                \then(pseqGet<V>(s, ki)) \else(pmapUndef<V>))
        \heuristics(simplify_enlarging)
    };

    // Added by Kai Wallisch
    \lemma
    getOfPMapUpdate {
        \find(pmapGet<K, V>(pmapUpdate<K, V>(m, key, value), key1))
        \replacewith(\if(key1 = key) \then(value) \else(pmapGet<K, V>(m, key1)))
        \heuristics(simplify_enlarging)
    };

    // Added by Kai Wallisch
    \lemma
    getOfPMapRemove {
        \find(pmapGet<K, V>(pmapRemove<K, V>(m, key), key1))
        \replacewith(\if(key1 = key) \then(pmapUndef<V>) \else(pmapGet<K, V>(m, key1)))
        \heuristics(simplify_enlarging)
    };
}
