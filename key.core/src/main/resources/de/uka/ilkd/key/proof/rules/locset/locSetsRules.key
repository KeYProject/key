// This file contains the RULES for location sets.
// Find the DECLARATIONS in file locSets.key

\rules(programRules:Java) {

    // --------------------------------------------------------------------------
    // axioms for elementOf
    // --------------------------------------------------------------------------

    elementOfAllLocs {
        \schemaVar \term Loc l;

        \find(elementOf<Loc>(l, allLocs))

        \replacewith(true)

        \heuristics(concrete)
    };

    elementOfInfiniteUnion2Vars {
        \schemaVar \term Loc l;
        \schemaVar \variables alpha av;
        \schemaVar \variables beta bv;
        \schemaVar \term LocSet s;

        \find(elementOf<Loc>(l, infiniteUnion<Loc>{av, bv;}(s)))
        \varcond(\notFreeIn(av, l), \notFreeIn(bv, l))

        \replacewith(\exists av; \exists bv; elementOf<Loc>(l, s))

        \heuristics(simplify)
        \generate(\EQ(infiniteUnion<Loc>{av, bv;}(s)))
    };

    elementOfAllFields {
        \schemaVar \term Pair<Object, Field> p;
        \schemaVar \term Object o2;

        \find(elementOf<Loc>(p, allFields(o2)))

        \replacewith(first<Object, Field>(p) = o2)

        \heuristics(concrete)
    };

    allFieldsEq {
        \schemaVar \term Object o1, o2;
        \find(allFields(o1) = allFields(o2))
        \replacewith(o1 = o2)
        \heuristics(simplify)
    };

    elementOfAllObjects {
        \schemaVar \term Loc l;
        \schemaVar \term Field f2;

        \find(elementOf<Loc>(l, allObjects(f2)))

        \replacewith(second<Object,Field>(l) = f2)

        \heuristics(concrete)
        \generate(\EQ(allObjects(f2)))
    };

    // change upper to exclusive (in line with other definitions?)
    elementOfArrayRange {
        \schemaVar \term Object o2;
        \schemaVar \term Loc l;
        \schemaVar \term int lower, upper;
        \schemaVar \variables int iv;

        \find(elementOf<Loc>(l, arrayRange(o2, lower, upper)))
        \varcond(\notFreeIn(iv, l, lower, upper))

        \replacewith(first<Object, Field>(l) = o2 & \exists iv; (second<Object, Field>(l) = arr(iv) & lower <= iv & iv <= upper))

        \heuristics(simplify_enlarging)
        \generate(\EQ(arrayRange(o2, lower, upper) : simplify))
    };

    // change upper to exclusive (in line with other definitions?)
    elementOfArrayRangeConcrete {
        \schemaVar \term Object o, o2;
        \schemaVar \term int idx, lower, upper;

        \find(elementOf<Loc>(pair<Object, Field>(o, arr(idx)), arrayRange(o2, lower, upper)))

        \replacewith(o = o2 & lower <= idx & idx <= upper)

        \heuristics(simplify)
    };

    elementOfFreshLocs {
        \schemaVar \term Pair<Object, Field> p;
        \schemaVar \term Heap h;

        \find(elementOf<Loc>(p, freshLocs(h)))

        \replacewith(first<Object, Field>(p) != null & !select<boolean>(h, first<Object, Field>(p), java.lang.Object::#$created) = TRUE)

        \heuristics(concrete)
    }

    // --------------------------------------------------------------------------
    // axioms for set predicates (reduce to elementOf)
    // --------------------------------------------------------------------------

    // proven with KeY (CS)
    equalityToElementOfRight {
        \schemaVar \term LocSet s, s2;
        \schemaVar \variables Object ov;
        \schemaVar \variables Field fv;

        \find( ==> s = s2)
        \varcond(\notFreeIn(ov, s, s2), \notFreeIn(fv, s, s2))

        \replacewith( ==> \forall ov; \forall fv; (elementOf<Loc>(pair<Object, Field>(ov, fv), s) <-> elementOf<Loc>(pair<Object, Field>(ov, fv), s2)))

        \heuristics(locSetEqualityBlastingRight)
    };

    subsetToElementOfLocSet {
        \schemaVar \term LocSet s, s2;
        \schemaVar \variables Object ov;
        \schemaVar \variables Field fv;

        \find(subset<Loc>(s, s2))
        \varcond(\notFreeIn(ov, s, s2), \notFreeIn(fv, s, s2))

        \replacewith(\forall ov; \forall fv; (elementOf<Loc>(pair<Object, Field>(ov, fv), s) -> elementOf<Loc>(pair<Object, Field>(ov, fv), s2)))
        \heuristics(semantics_blasting)
        //        \heuristics(simplify)
    };

    // proven with KeY (CS)
    subsetToElementOfLocSetRight {
        \schemaVar \term LocSet s, s2;
        \schemaVar \variables Object ov;
        \schemaVar \variables Field fv;

        \find( ==> subset<Loc>(s, s2))
        \varcond(\notFreeIn(ov, s, s2), \notFreeIn(fv, s, s2))

        \replacewith( ==> \forall ov; \forall fv; (elementOf<Loc>(pair<Object, Field>(ov, fv), s) -> elementOf<Loc>(pair<Object, Field>(ov, fv), s2)))

        \heuristics(locSetEqualityBlastingRight)
    };

    // proven with KeY (CS)
    allFieldsSubsetOf {
        \schemaVar \term LocSet s;
        \schemaVar \term Object o;
        \schemaVar \term Field f;

        \assumes(subset<Loc>(allFields(o), s) ==>)
        \find(elementOf<Loc>(pair<Object, Field>(o, f), s))

        \replacewith(true)

        \heuristics(concrete)
    };

    disjointToElementOfLocSet {
        \schemaVar \term LocSet s, s2;
        \schemaVar \variables Object ov;
        \schemaVar \variables Field fv;

        \find(disjoint<Loc>(s, s2))
        \varcond(\notFreeIn(ov, s, s2), \notFreeIn(fv, s, s2))

        \replacewith(\forall ov; \forall fv; (!elementOf<Loc>(pair<Object, Field>(ov, fv), s) | !elementOf<Loc>(pair<Object, Field>(ov, fv), s2)))
        \heuristics(semantics_blasting)
        //        \heuristics(simplify)
    };

    // proven with KeY (CS)
    disjointAllFields {
        \schemaVar \term LocSet s;
        \schemaVar \term Object o;
        \schemaVar \term Field f;

        \assumes(intersect<Loc>(allFields(o), s) = empty<Loc> ==>)
        \find(elementOf<Loc>(pair<Object, Field>(o, f), s))

        \replacewith(false)

        \heuristics(concrete)
    };

    // proven with KeY (CS)
    disjointAllFields_2 {
        \schemaVar \term Object o, o2;
        \schemaVar \term Field f;

        \find(intersect<Loc>(allFields(o), allFields(o2)) = empty<Loc>)

        \replacewith(o != o2)

        \heuristics(concrete)
    };

    // proven with KeY (CS)
    disjointAllObjects {
        \schemaVar \term LocSet s;
        \schemaVar \term Object o;
        \schemaVar \term Field f;

        \assumes(intersect<Loc>(allObjects(f), s) = empty<Loc> ==>)
        \find(elementOf<Loc>(pair<Object, Field>(o, f), s))

        \replacewith(false)

        \heuristics(concrete)
    };

    // proven with KeY (CS)
    intersectAllFieldsFreshLocs {
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \schemaVar \term Heap h;

        \find(intersect<Loc>(allFields(o), freshLocs(h)) = empty<Loc>)
        \replacewith(o = null | select<boolean>(h, o, java.lang.Object::#$created) = TRUE)
        \heuristics(simplify)
    };

    createdInHeapToElementOf {
        \schemaVar \term LocSet s;
        \schemaVar \term Heap h;
        \schemaVar \variables Object ov;
        \schemaVar \variables Field fv;

        \find(createdInHeap(s, h))
        \varcond(\notFreeIn(ov, s, h), \notFreeIn(fv, s, h))

        \replacewith(\forall ov; \forall fv; (elementOf<Loc>(pair<Object, Field>(ov, fv), s)
                -> ov = null
                | select<boolean>(h, ov, java.lang.Object::#$created) = TRUE))
        \heuristics(classAxiom)
    };

    // --------------------------------------------------------------------------
    // lemmas for allLocs
    // --------------------------------------------------------------------------

    unionWithAllLocs {
        \schemaVar \term LocSet s;

        \find(union<Loc>(allLocs, s))

        \replacewith(allLocs)

        \heuristics(concrete)
    };

    intersectWithAllLocs {
        \schemaVar \term LocSet s;

        \find(intersect<Loc>(allLocs, s))

        \replacewith(s)

        \heuristics(concrete)
    };

    unionWithAllLocsRight {
        \schemaVar \term LocSet s;

        \find(union<Loc>(s, allLocs))

        \replacewith(allLocs)

        \displayname "unionWithAllLocs"
        \heuristics(concrete)
    };

    intersectWithAllLocsRight {
        \schemaVar \term LocSet s;

        \find(intersect<Loc>(s, allLocs))

        \replacewith(s)

        \displayname "intersectWithAllLocs"

        \heuristics(concrete)
    };

    //  end

    setMinusWithAllLocs {
        \schemaVar \term LocSet s;

        \find(setMinus<Loc>(s, allLocs))

        \replacewith(empty<Loc>)

        \displayname "setMinusWithAllLocs"
        \heuristics(concrete)
    };

    // --------------------------------------------------------------------------
    // lemmas for subset
    // --------------------------------------------------------------------------

    subsetWithAllLocs {
        \schemaVar \term LocSet s;

        \find(subset<Loc>(s, allLocs))

        \replacewith(true)

        \displayname "subsetOfAllLocs" // should be the name, but for backward compatibility only displayname
        \heuristics(concrete)
    };

    subsetWithAllLocs2 {
        \schemaVar \term LocSet s;

        \find(subset<Loc>(allLocs, s))
        \replacewith(s = allLocs)

        \displayname "subsetWithAllLocs"
        \heuristics(concrete)
    };

    // --------------------------------------------------------------------------
    // lemmas for disjoint
    // --------------------------------------------------------------------------

    \lemma
    disjointArrayRanges {
        \schemaVar \term Object o1, o2;
        \schemaVar \term int lower1, upper1, lower2, upper2;
        \find(intersect<Loc>(arrayRange(o1, lower1, upper1), arrayRange(o2, lower2, upper2)) = empty<Loc>)
        \replacewith(!(o1 = o2 & lower1 <= upper1 & lower2 <= upper2 & ((lower1 <= lower2 & lower2 <= upper1) | (lower2 <= lower1 & lower1 <= upper2))))
        \heuristics(simplify)
    };

    \lemma
    disjointArrayRangeAllFields1 {
        \schemaVar \term Object o1, o2;
        \schemaVar \term int lower2, upper2;
        \find(intersect<Loc>(allFields(o1), arrayRange(o2, lower2, upper2)) = empty<Loc>)
        \replacewith(!(o1 = o2 & lower2 <= upper2))
        \heuristics(simplify)
        \displayname "disjointArrayRangeAllFields"
    };

    \lemma
    disjointArrayRangeAllFields2 {
        \schemaVar \term Object o1, o2;
        \schemaVar \term int lower1, upper1;
        \find(intersect<Loc>(arrayRange(o1, lower1, upper1), allFields(o2)) = empty<Loc>)
        \replacewith(!(o1 = o2 & lower1 <= upper1))
        \heuristics(simplify)
        \displayname "disjointArrayRangeAllFields"
    };

    \lemma
    disjointAllObjects2 {
        \schemaVar \term Field f1, f2;
        \find(intersect<Loc>(allObjects(f1), allObjects(f2)) = empty<Loc>)
        \replacewith(f1 != f2)
        \heuristics(concrete)
        \displayname "disjointAllObjects"
    }

    \lemma
    arrayRangeEmpty {
        \schemaVar \term Object o, o2;
        \schemaVar \term int lower, upper;
        \find(arrayRange(o, lower, upper) = empty<Loc>)
        \replacewith(upper < lower)
        \heuristics(simplify)
    }

    \lemma
    intersectAllFieldsAllObjects {
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \find(intersect<Loc>(allFields(o), allObjects(f)))
        \replacewith(singleton<Loc>(pair<Object, Field>(o, f)))
        \heuristics(simplify)
        \generate(\EQ(allFields(o)))
        \displayname "intersectAllFieldsAllObjects"
    }

    \lemma
    intersectAllFieldsAllObjects2 {
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \find(intersect<Loc>(allObjects(f), allFields(o)))
        \replacewith(singleton<Loc>(pair<Object, Field>(o, f)))
        \heuristics(simplify)
        \generate(\EQ(allObjects(f)))
        \displayname "intersectAllFieldsAllObjects"
    }

    \lemma
    disjointAllFieldsSingleton {
        \schemaVar \term Object o, o2;
        \schemaVar \term Field f;
        \find(intersect<Loc>(allFields(o), singleton<Loc>(pair<Object, Field>(o2, f))) = empty<Loc>)
        \replacewith(o != o2)
        \heuristics(concrete)
        \displayname "disjointAllFieldsSingleton"
    }

    \lemma
    disjointAllFieldsSingleton2 {
        \schemaVar \term Object o, o2;
        \schemaVar \term Field f;
        \find(intersect<Loc>(singleton<Loc>(pair<Object, Field>(o2, f)), allFields(o)) = empty<Loc>)
        \replacewith(o != o2)
        \heuristics(concrete)
        \displayname "disjointAllFieldsSingleton"
    }

    \lemma
    intersectAllFieldsSingletonSame {
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \find(intersect<Loc>(allFields(o), singleton<Loc>(pair<Object, Field>(o, f))))
        \replacewith(singleton<Loc>(pair<Object, Field>(o, f)))
        \heuristics(simplify)
        \displayname "intersectAllFieldsSingleton"
    }

    \lemma
    intersectAllFieldsSingletonSame2 {
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \find(intersect<Loc>(singleton<Loc>(pair<Object, Field>(o, f)), allFields(o)))
        \replacewith(singleton<Loc>(pair<Object, Field>(o, f)))
        \heuristics(simplify)
        \displayname "intersectAllFieldsSingleton"
    }

    \lemma
    intersectAllFieldsSingletonDiff {
        \schemaVar \term Object o, o2;
        \schemaVar \term Field f;
        \assumes( ==> o = o2)
        \find(intersect<Loc>(allFields(o), singleton<Loc>(pair<Object, Field>(o2, f))))
        \replacewith(empty<Loc>)
        \heuristics(simplify)
        \displayname "intersectAllFieldsSingleton"
    }

    \lemma
    intersectAllFieldsSingletonDiff2 {
        \schemaVar \term Object o, o2;
        \schemaVar \term Field f;
        \assumes( ==> o = o2)
        \find(intersect<Loc>(singleton<Loc>(pair<Object, Field>(o2, f)), allFields(o)))
        \replacewith(empty<Loc>)
        \heuristics(simplify)
        \displayname "intersectAllFieldsSingleton"
    }

    \lemma
    disjointAllObjectsSingleton {
        \schemaVar \term Object o;
        \schemaVar \term Field f, f2;
        \find(intersect<Loc>(allObjects(f), singleton<Loc>(pair<Object, Field>(o, f2))) = empty<Loc>)
        \replacewith(f != f2)
        \heuristics(concrete)
        \displayname "disjointAllObjectsSingleton"
    }

    \lemma
    disjointAllObjectsSingleton2 {
        \schemaVar \term Object o;
        \schemaVar \term Field f, f2;
        \find(intersect<Loc>(singleton<Loc>(pair<Object, Field>(o, f2)), allObjects(f)) = empty<Loc>)
        \replacewith(f != f2)
        \heuristics(concrete)
        \displayname "disjointAllObjectsSingleton"
    }

    \lemma
    intersectAllObjectsSingletonSame {
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \find(intersect<Loc>(allObjects(f), singleton<Loc>(pair<Object, Field>(o, f))))
        \replacewith(singleton<Loc>(pair<Object, Field>(o, f)))
        \heuristics(simplify)
        \displayname "intersectAllObjectsSingleton"
    }

    \lemma
    intersectAllObjectsSingletonSame2 {
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \find(intersect<Loc>(singleton<Loc>(pair<Object, Field>(o, f)), allObjects(f)))
        \replacewith(singleton<Loc>(pair<Object, Field>(o, f)))
        \heuristics(simplify)
        \displayname "intersectAllObjectsSingleton"
    }

    \lemma
    intersectAllObjectsSingletonDiff {
        \schemaVar \term Object o;
        \schemaVar \term Field f, f2;
        \assumes( ==> f = f2)
        \find(intersect<Loc>(allObjects(f), singleton<Loc>(pair<Object, Field>(o, f2))))
        \replacewith(empty<Loc>)
        \heuristics(simplify)
        \displayname "intersectAllObjectsSingleton"
    }

    \lemma
    intersectAllObjectsSingletonDiff2 {
        \schemaVar \term Object o;
        \schemaVar \term Field f, f2;
        \assumes( ==> f = f2)
        \find(intersect<Loc>(singleton<Loc>(pair<Object, Field>(o, f2)), allObjects(f)))
        \replacewith(empty<Loc>)
        \heuristics(simplify)
        \displayname "intersectAllObjectsSingleton"
    }

    \lemma
    intersectArrayRangeAllFieldsSame {
        \schemaVar \term Object o;
        \schemaVar \term int lower, upper;
        \find(intersect<Loc>(arrayRange(o, lower, upper), allFields(o)))
        \replacewith(arrayRange(o, lower, upper))
        \heuristics(simplify)
        \displayname "intersectArrayRangeAllFields"
    }

    \lemma
    intersectArrayRangeAllFieldsSame2 {
        \schemaVar \term Object o;
        \schemaVar \term int lower, upper;
        \find(intersect<Loc>(allFields(o), arrayRange(o, lower, upper)))
        \replacewith(arrayRange(o, lower, upper))
        \heuristics(simplify)
        \displayname "intersectArrayRangeAllFields"
    }

    \lemma
    intersectArrayRangeAllFieldsDiff {
        \schemaVar \term Object o, o2;
        \schemaVar \term int lower, upper;
        \assumes( ==> o = o2)
        \find(intersect<Loc>(arrayRange(o, lower, upper), allFields(o2)))
        \replacewith(empty<Loc>)
        \heuristics(simplify)
        \displayname "intersectArrayRangeAllFields"
    }

    \lemma
    intersectArrayRangeAllFieldsDiff2 {
        \schemaVar \term Object o, o2;
        \schemaVar \term int lower, upper;
        \assumes( ==> o = o2)
        \find(intersect<Loc>(allFields(o2), arrayRange(o, lower, upper)))
        \replacewith(empty<Loc>)
        \heuristics(simplify)
        \displayname "intersectArrayRangeAllFields"
    }

    \lemma
    unionArrayRangeAdjacent {
        \schemaVar \term Object o;
        \schemaVar \term int lower, upper, lower2, upper2;
        \find(union<Loc>(arrayRange(o, lower, upper), arrayRange(o, lower2, upper2)))
        \replacewith(\if(lower <= upper & lower2 = add(upper, 1) & upper < upper2) \then(arrayRange(o, lower, upper2)) \else(union<Loc>(arrayRange(o, lower, upper), arrayRange(o, lower2, upper2))))
        \heuristics(locSetArrayRangeMerge)
        \generate(\EQ(arrayRange(o, lower, upper)))
    }

    \lemma
    intersectArrayRangesNested {
        \schemaVar \term Object o;
        \schemaVar \term int lower, upper, lower2, upper2;
        \find(intersect<Loc>(arrayRange(o, lower, upper), arrayRange(o, lower2, upper2)))
        \replacewith(\if(lower <= lower2 & upper2 <= upper) \then(arrayRange(o, lower2, upper2)) \else(intersect<Loc>(arrayRange(o, lower, upper), arrayRange(o, lower2, upper2))))
        \heuristics(locSetArrayRangeInterNested)
        \generate(\EQ(arrayRange(o, lower, upper)))
        \displayname "intersectArrayRangesNested"
    }

    \lemma
    intersectArrayRangesNested2 {
        \schemaVar \term Object o;
        \schemaVar \term int lower, upper, lower2, upper2;
        \find(intersect<Loc>(arrayRange(o, lower, upper), arrayRange(o, lower2, upper2)))
        \replacewith(\if(lower2 <= lower & upper <= upper2) \then(arrayRange(o, lower, upper)) \else(intersect<Loc>(arrayRange(o, lower, upper), arrayRange(o, lower2, upper2))))
        \heuristics(locSetArrayRangeInterNested2)
        \generate(\EQ(arrayRange(o, lower2, upper2)))
        \displayname "intersectArrayRangesNested"
    }

    \lemma
    intersectArrayRangesDisjoint {
        \schemaVar \term Object o;
        \schemaVar \term int lower, upper, lower2, upper2;
        \find(intersect<Loc>(arrayRange(o, lower, upper), arrayRange(o, lower2, upper2)))
        \replacewith(\if(upper < lower2) \then(empty<Loc>) \else(intersect<Loc>(arrayRange(o, lower, upper), arrayRange(o, lower2, upper2))))
        \heuristics(locSetArrayRangeInterDisjoint)
        \generate(\EQ(arrayRange(o, lower, upper)))
        \displayname "intersectArrayRangesDisjoint"
    }

    \lemma
    intersectArrayRangesDisjoint2 {
        \schemaVar \term Object o;
        \schemaVar \term int lower, upper, lower2, upper2;
        \find(intersect<Loc>(arrayRange(o, lower, upper), arrayRange(o, lower2, upper2)))
        \replacewith(\if(upper2 < lower) \then(empty<Loc>) \else(intersect<Loc>(arrayRange(o, lower, upper), arrayRange(o, lower2, upper2))))
        \heuristics(locSetArrayRangeInterDisjoint2)
        \generate(\EQ(arrayRange(o, lower2, upper2)))
        \displayname "intersectArrayRangesDisjoint"
    }

    // --------------------------------------------------------------------------
    // lemmas for createdInHeap
    // --------------------------------------------------------------------------

    createdInHeapWithEmpty {
        \schemaVar \term Heap h;

        \find(createdInHeap(empty<Loc>, h))

        \replacewith(true)

        \heuristics(concrete)
    };

    createdInHeapWithSingleton {
        \schemaVar \term Loc l;
        \schemaVar \term Heap h;

        \find(createdInHeap(singleton<Loc>(l), h))

        \replacewith(first<Object,Field>(l) = null | select<boolean>(h, first<Object,Field>(l), java.lang.Object::#$created) = TRUE)

        \heuristics(simplify_enlarging)
        \generate(\EQ(singleton<Loc>(l)))
    };

    createdInHeapWithUnion {
        \schemaVar \term LocSet s, s2;
        \schemaVar \term Heap h;

        \find( ==> createdInHeap(union<Loc>(s, s2), h))

        \replacewith( ==> createdInHeap(s, h));
        \replacewith( ==> createdInHeap(s2, h))

        \heuristics(simplify_enlarging)
        \generate(\EQ(union<Loc>(s, s2)))
    };

    createdInHeapWithSetMinusFreshLocs {
        \schemaVar \term LocSet s;
        \schemaVar \term Heap h;

        \find(createdInHeap(setMinus<Loc>(s, freshLocs(h)), h))

        \replacewith(true)

        \heuristics(concrete)
        \generate(\EQ(setMinus<Loc>(s, freshLocs(h))))
    };

    createdInHeapWithAllFields {
        \schemaVar \term Object o;
        \schemaVar \term Heap h;

        \find(createdInHeap(allFields(o), h))

        \replacewith(o = null | select<boolean>(h, o, java.lang.Object::#$created) = TRUE)

        \heuristics(simplify_enlarging)
        \generate(\EQ(allFields(o)))
    };

    createdInHeapWithArrayRange {
        \schemaVar \term Object o;
        \schemaVar \term int lower, upper;
        \schemaVar \term Heap h;

        \find(createdInHeap(arrayRange(o, lower, upper), h))

        \replacewith(o = null | select<boolean>(h, o, java.lang.Object::#$created) = TRUE | upper < lower)

        \heuristics(simplify_enlarging)
        \generate(\EQ(arrayRange(o, lower, upper)))
    };

    createdInHeapWithSelect {
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \schemaVar \term Heap h;

        \find( ==> createdInHeap(select<LocSet>(h, o, f), h))

        \replacewith( ==> wellFormed(h))

        \heuristics(concrete)
        \generate(\EQ(select<LocSet>(h, o, f)))
    };

    createdInHeapWithObserver {
        \schemaVar \term LocSet obs;
        \schemaVar \term Heap h;

        \find( ==> createdInHeap(obs, h))
        \varcond(\isObserver(obs, h))

        \replacewith( ==> wellFormed(h))

        \heuristics(concrete)
        \generate(\EQ(obs))
    };

    // --------------------------------------------------------------------------
    // other lemmas for proving createdness
    // --------------------------------------------------------------------------

    referencedObjectIsCreatedRight {
        \schemaVar \term Heap h;
        \schemaVar \term Object o;
        \schemaVar \term Field f;

        \assumes( ==> select<deltaObject>(h, o, f) = null)
        \find( ==> select<boolean>(h,
                select<deltaObject>(h, o, f),
                java.lang.Object::#$created) = TRUE)

        \replacewith( ==> wellFormed(h))

        \heuristics(concrete)
        \generate(\EQ(select<deltaObject>(h, o, f)))
    };

    referencedObjectIsCreatedRightFinal {
        \schemaVar \term Heap h;
        \schemaVar \term Object o;
        \schemaVar \term Field f;

        \assumes( ==> final<deltaObject>(o, f) = null)
        \find( ==> select<boolean>(h,
                final<deltaObject>(o, f),
                java.lang.Object::#$created) = TRUE )

        \replacewith( ==> select<boolean>(h, o, java.lang.Object::#$created) = TRUE | o = null )

        \heuristics(simplify_enlarging)
    };

    referencedObjectIsCreatedRightFinalEQ {
        \schemaVar \term Heap h;
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \schemaVar \term Object EQ;

        \assumes(final<deltaObject>(o, f) = EQ ==> EQ = null)
        \find( ==> select<boolean>(h,
                EQ,
                java.lang.Object::#$created) = TRUE)

        \add( ==> select<boolean>(h, o, java.lang.Object::#$created) = TRUE | o = null )

        \heuristics(concrete)
    };

    // --------------------------------------------------------------------------
    // work-a-round to use \infinite_union in JML set statements
    // --------------------------------------------------------------------------

    definitionAllElementsOfArray {
        \schemaVar \term Object array;
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \schemaVar \term Heap h;
        \schemaVar \variables int j;

        \find(allElementsOfArray(h, array, singleton<Loc>(pair<Object, Field>(o, f))))
        \varcond(\notFreeIn(j, h), \notFreeIn(j, array), \notFreeIn(j, o, f))

        \replacewith(infiniteUnion<Loc>{j;}(\if(0 <= j & j < length(array))
                    \then(singleton<Loc>(pair<Object, Field>(select<Object>(h, array, arr(j)), f)))
                    \else(empty<Loc>)))
        \heuristics(simplify)
    };

    definitionAllElementsOfArray2 {
        \schemaVar \term Object array;
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \schemaVar \term Heap h;
        \schemaVar \variables int j;

        \find(allElementsOfArray(h, array, allFields(o)))
        \varcond(\notFreeIn(j, h), \notFreeIn(j, array))

        \replacewith(infiniteUnion<Loc>{j;}(\if(0 <= j & j < length(array))
                    \then(allFields(select<Object>(h, array, arr(j))))
                    \else(empty<Loc>)))
        \heuristics(simplify)
    };

    definitionAllElementsOfArrayLocsets {
        \schemaVar \term Object array;
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \schemaVar \term Heap h;
        \schemaVar \variables int j;

        \find(allElementsOfArrayLocsets(h, array, singleton<Loc>(pair<Object, Field>(o, f))))
        \varcond(\notFreeIn(j, h), \notFreeIn(j, array), \notFreeIn(j, o, f))

        \replacewith(infiniteUnion<Loc>{j;}(\if(0 <= j & j < length(array))
                    \then(select<LocSet>(h, select<Object>(h, array, arr(j)), f))
                    \else(empty<Loc>)))
        \heuristics(simplify)
    };
}
