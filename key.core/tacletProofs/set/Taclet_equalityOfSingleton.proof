\proof {
(keyLog "0" (keyUser "ulbrich" ) (keyVersion "af00212456641ec51f1d89b225061fe018faa149"))
(keyLog "1" (keyUser "daniel" ) (keyVersion "9f5c2371129286ae614d0425699f44df59316f59"))

(autoModeTime "240")

(branch "dummy ID"
(rule "equalityToElementOf" (formula "1") (term "0") (newnames "f_e1,f_e2") (inst "av=av:T") (userinteraction))
(rule "eqSymm" (formula "1") (term "1"))
(rule "elementOfSingleton" (formula "1") (term "0,0,0"))
(rule "elementOfSingleton" (formula "1") (term "1,0,0"))
(rule "equiv_right" (formula "1"))
(branch "Case '->'"
   (rule "cnf_eqv" (formula "1") (term "0"))
   (rule "distr_forallAnd" (formula "1"))
    (builtin "One Step Simplification" (formula "1") (ifInst ""  (formula "2")))
   (rule "closeFalse" (formula "1"))
)
(branch "Case '<-'"
   (rule "allRight" (formula "2") (inst "sk=av_0:T"))
   (rule "eqSymm" (formula "2") (term "0"))
   (rule "eqSymm" (formula "2") (term "1"))
   (rule "applyEq" (formula "2") (term "0,1") (ifseqformula "1"))
    (builtin "One Step Simplification" (formula "2"))
   (rule "closeTrue" (formula "2"))
)
)
}
