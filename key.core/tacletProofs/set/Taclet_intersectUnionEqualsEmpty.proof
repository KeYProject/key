      (rule "elementOfEmpty" (formula "2") (term "1,0"))
      (rule "concrete_eq_4" (formula "2") (term "0"))
      (rule "allRight" (formula "2") (inst "sk=av_0:T"))
      (rule "notRight" (formula "2"))
      (rule "elementOfIntersect" (formula "1"))
      (rule "andLeft" (formula "1"))
      (rule "disjointNotInOtherSet2" (formula "2") (ifseqformula "3"))
      (rule "elementOfUnion" (formula "4"))
      (rule "orRight" (formula "4"))
