\functions {
    LocSet s1;
    LocSet s2;
    LocSet s3;
    LocSet s4;
    LocSet s5;
    LocSet s6;
    LocSet s7;
    LocSet s8;
    Field f;
}


\problem {
    s1 = infiniteUnion<Loc>{Object o;}(singleton<Loc>(pair<Object,Field>(o, f)))
    & s2 = singleton<Loc>(pair<Object,Field>(null, f))
    & s3 = s1
    & s5 = s8
    & subset<Loc>(s3, s5)
    & s8 = s4
    & s7 = s2
    & s7 = s6 
    -> subset<Loc>(s6, s4)
}
