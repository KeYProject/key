/*
    This problem states that there is a map with infinite entries.
    I already proved this using induction but KeY crashed when I tried saving the proof.
    
    Kai Wallisch 08/2014
*/

\problem{
    // instantiate this quantifier for example with: mapForeach<any, any>{int i;}(TRUE,0)
    true -> \exists Map<any, any> infiniteMap; !mapIsFinite<any, any>(infiniteMap)
}

