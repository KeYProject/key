\javaSource "src";

\programVariables {
  Node x;
}

\problem {
  !wellFormed(heap)
}

\proofScript {
  rule notRight;
  cut "\<{ x = new Node(); }\> x = null";
  rule diamondToBox;
  auto;
  auto;
  cut "reach(store(heap, n_2, Node::#next, n_2), allObjects(Node::#next), n_2, n_2, 1) -> reach(anon(store(heap, n_2, Node::#next, n_2), empty<Loc>, store(heap, n_2, Node::#next, null)), allObjects(Node::#next), n_2, n_2, 1)";
  auto;
  rule reachDependenciesAnonCoarse;
  auto all;
}
