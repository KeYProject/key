\sorts {
    T;
}


\problem {
\forall Set<T> s1;
  \forall Set<T> s2;
    (    intersect<T>(s1, s2) = empty<T>
     <-> \forall T a;
           (elementOf<T>(a, s1) -> !elementOf<T>(a, s2)))
}

\proof {
(keyLog "0" (keyUser "daniel" ) (keyVersion "3e5e375a5961f774f564a01b1e406905665f8f19"))

(autoModeTime "127")

(branch "dummy ID"
(rule "allRight" (formula "1") (inst "sk=s1_0:Set<T>"))
(rule "allRight" (formula "1") (inst "sk=s2_0:Set<T>"))
(rule "nnf_imp2or" (formula "1") (term "0,1"))
(rule "equiv_right" (formula "1"))
(branch "Case '->'"
   (rule "allRight" (formula "2") (inst "sk=a_0:T"))
   (rule "orRight" (formula "2"))
   (rule "notRight" (formula "2"))
   (rule "notRight" (formula "3"))
   (rule "disjointNotInOtherSet1" (formula "2") (ifseqformula "3"))
   (rule "close" (formula "4") (ifseqformula "1"))
)
(branch "Case '<-'"
   (rule "equalityToElementOf" (formula "2") (inst "av=av:T") (userinteraction))
    (builtin "One Step Simplification" (formula "2"))
   (rule "allRight" (formula "2") (inst "sk=av_0:T"))
   (rule "notRight" (formula "2"))
   (rule "elementOfIntersect" (formula "1"))
   (rule "andLeft" (formula "1"))
   (rule "allLeft" (formula "3") (inst "t=av_0:T"))
   (rule "replace_known_left" (formula "3") (term "0,0") (ifseqformula "1"))
    (builtin "One Step Simplification" (formula "3") (ifInst ""  (formula "2")))
   (rule "closeFalse" (formula "3"))
)
)
}
